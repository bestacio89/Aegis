# ========================================
# Aegis — Production .gitignore
# .NET / WPF / Visual Studio / Node.js / TypeScript
# ========================================

# ----------------------------------------
# .NET build outputs
# ----------------------------------------
[Bb]in/
[Oo]bj/
[Aa]rtifacts/
[Bb]uild/
[Bb]uildDebug/
[Bb]uildRelease/
[Dd]ebug/
[Rr]elease/
publish/
.publish/
TestResults/
[Tt]est[Rr]esults/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
_ReSharper.Caches/
Generated_Code/
_ServiceReferences/

# Preserve explicitly maintained build configuration and source.
!Directory.Build.props
!Directory.Build.targets
!Directory.Packages.props
!global.json

# ----------------------------------------
# Visual Studio / IDE user state
# ----------------------------------------
.vs/
.idea/
_ReSharper*/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.opendb
*.sln.ide
.localhistory/

# Keep .vscode project configuration if intentionally maintained.
# Do not ignore the entire .vscode directory.

# ----------------------------------------
# Compilers, temporary files and logs
# ----------------------------------------
*.ncb
*.obj
*.pdb
*.idb
*.tlog
*.ilk
*.aps
*.pch
*.ipch
*.vsp
*.vspx
*.psess
*.etl
*.trace
*.svclog
*.tmp
*.tmp_proj
*.cache
*.log
*.old
*.bak
*.lastcodeanalysissucceeded
*.codeanalysis
*.codeanalysislog
*.coverage
*.coveragexml
*.VisualState.xml
TestResult.xml
*.trx

# ----------------------------------------
# NuGet — exclude packages, retain manifests
# ----------------------------------------
packages/
.nuget/packages/
*.nupkg
*.snupkg

# Keep packages.config, NuGet.Config, and project dependency
# declarations. Commit NuGet.Config only when it contains no secrets.
# Do not globally ignore *.nuspec, *.props, or *.targets.

# ----------------------------------------
# Node.js / npm / JavaScript / TypeScript
# ----------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.pnpm-store/

# Build and test output
coverage/
.nyc_output/
dist/
# Do not globally ignore build/ here: .NET projects may use it.

# TypeScript incremental compilation
*.tsbuildinfo

# Keep package.json, package-lock.json, npm-shrinkwrap.json,
# yarn.lock, pnpm-lock.yaml, tsconfig*.json and source files.

# ----------------------------------------
# Environment variables and secrets
# ----------------------------------------
.env
.env.*
!.env.example
!.env.template

**/secrets.json
**/secrets.*.json
*.publishsettings
*.pfx
*.p12
*.key
*.pem
*.snk

# Certificates and local configuration should be committed only
# when they are explicitly intended to be public test fixtures.
# Never commit credentials, tokens, connection strings or private keys.

# ----------------------------------------
# Azure / deployment / publishing
# ----------------------------------------
*.azurePubxml
*.pubxml.user
*.publishproj.user

# Preserve deployment definitions and pipeline YAML.
# Do not ignore AzurePipelines/, .github/, or deployment scripts globally.

# ----------------------------------------
# Generated source — use narrow exclusions
# ----------------------------------------
# Keep generated source that is required by the build or intentionally
# checked in. Do not globally ignore *.g.cs, *.g.*, or *.designer.cs.
# Ignore only project-specific generated directories when appropriate.

# ----------------------------------------
# Entity Framework / database
# ----------------------------------------
# Do not ignore Migrations/ globally: EF migrations are source code.
# Do not ignore *.sql globally: reviewed SQL scripts can be source code.
*.dbmdl
*.sqlproj.user

# Local database files
*.sqlite
*.sqlite3
*.mdf
*.ldf

# Ignore *.db only if the repository does not contain intentional
# versioned database fixtures:
# *.db

# ----------------------------------------
# OS-generated files
# ----------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ----------------------------------------
# Profiling and diagnostics
# ----------------------------------------
*.tss
*.sap

# ----------------------------------------
# Preserve important repository metadata
# ----------------------------------------
!.editorconfig
!.gitattributes
!.gitignore
!.github/
!.azure-pipelines.yml
!Directory.Build.props
!Directory.Build.targets
!Directory.Packages.props
!global.json
