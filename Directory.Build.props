<Project>

  <PropertyGroup>
    <!-- Disable vulnerability scanning on private feeds -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <NoWarn>NU1900</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AuditExclusion Include="FranzPlatform" />
  </ItemGroup>
  <!-- ===============================
       Global Build Properties
       =============================== -->
  <PropertyGroup>
    
    <!-- Framework & Language -->
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code Quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <WarningsAsErrors>CS8600;CS8602;CS8618;CS8629;CS8632</WarningsAsErrors>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>

    <!-- Company & Metadata -->
    <Authors>Bernardo Estacio Abreu</Authors>
    <Company>AjnaTellus</Company>
    <Product>Aegis</Product>
    <RepositoryUrl>https://dev.azure.com/Ajna/Aegis</RepositoryUrl>
    <Version>1.0.0-alpha</Version>
    <Copyright>© 2025 AjnaTellus Systems</Copyright>

    <!-- Build Output -->
    <OutputPath>$(SolutionDir)artifacts\$(MSBuildProjectName)\</OutputPath>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>

    <!-- StyleCop / Analyzer Defaults -->
    <CodeAnalysisRuleSet>$(SolutionDir)Aegis.ruleset</CodeAnalysisRuleSet>

    <!-- Enable Source Link if public -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(BUILD_BUILDID)' != ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- ===============================
       Platform-Specific Overrides
       =============================== -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Aegis.App.WPF'">
    <UseWPF>true</UseWPF>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Aegis.App.Maui'">
    <UseMaui>true</UseMaui>
    <TargetFrameworks>net9.0-windows10.0.19041.0;net9.0-maccatalyst</TargetFrameworks>
    <SingleProject>true</SingleProject>
  </PropertyGroup>


</Project>
