<Project>

  <!-- =============================================
       Global Warnings / Security
       ============================================= -->
  <PropertyGroup>
    <NuGetAuditMode>direct</NuGetAuditMode>

    <!-- Combine all NoWarn values safely -->
    <NoWarn>$(NoWarn);NU1900;1591;1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AuditExclusion Include="FranzPlatform" />
  </ItemGroup>


  <!-- =============================================
       GLOBAL BUILD CONFIGURATION (.NET 10 baseline)
       ============================================= -->
  <PropertyGroup>
    <!-- Framework (base for non-UI projects) -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Language -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code Quality -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->
    <WarningsNotAsErrors>NU1608</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>

    <!-- Nullability warnings that matter -->
    <WarningsAsErrors>CS8600;CS8602;CS8618;CS8629;CS8632</WarningsAsErrors>

    <!-- Documentation -->

    <!-- Metadata -->
    <Authors>Bernardo Estacio Abreu</Authors>
    <Company>Enthelekheia</Company>
    <Product>Aegis</Product>
    <RepositoryUrl>https://dev.azure.com/AjnaTellus/_git/Aegis</RepositoryUrl>
    <Version>1.0.0-alpha</Version>
    <Copyright>© 2025 Enthelekheia Systems</Copyright>



    <!-- Analyzer rules -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- SourceLink -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- CI -->
    <ContinuousIntegrationBuild Condition="'$(BUILD_BUILDID)' != ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>


  <!-- =============================================
       WPF OVERRIDE (correct name!)
       ============================================= -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Aegis.App.Wpf'">
    <UseWPF>true</UseWPF>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>


  <!-- =============================================
       MAUI OVERRIDE — upgraded to .NET 10 workloads
       ============================================= -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Aegis.App.Maui'">
    <UseMaui>true</UseMaui>

    <!-- Real .NET 10 Maui target frameworks -->
    <TargetFrameworks>
      net10.0-windows10.0.19041.0;
      net10.0-maccatalyst;
      net10.0-android
    </TargetFrameworks>

    <SingleProject>true</SingleProject>
  </PropertyGroup>

</Project>
