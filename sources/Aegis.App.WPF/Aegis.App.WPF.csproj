<Project Sdk="Microsoft.NET.Sdk">

  <!-- =============================================
       AEGIS WPF FRONTEND — .NET 10 Desktop Dashboard
       ============================================= -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWpf>true</UseWpf>

    <!-- Upgraded to .NET 10 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

    <AssemblyName>Aegis.App.Wpf</AssemblyName>
    <RootNamespace>Aegis.App.Wpf</RootNamespace>

    <Description>
      WPF Dashboard for Aegis — visualization of architecture audits, rule results, and reports.
    </Description>

    <!-- Avoid platform warnings -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- =============================================
       UI / Views
       ============================================= -->
  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

  <!-- =============================================
       Dependencies — Updated to .NET 10 compatible versions
       ============================================= -->
  <ItemGroup>

    <!-- WPF UI -->
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />

    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Logging -->
    <PackageReference Include="Franz.Common.Logging" Version="1.6.21" />

    <!-- Dependency Injection -->
    <PackageReference Include="Franz.Common.DependencyInjection" Version="1.6.21" />

    <!-- Microsoft Extensions (.NET 10 versions) -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

    <!-- WebView for in-app HTML reports -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />

    <!-- Charts -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />

    <!-- Reporting (PDF) -->
    <PackageReference Include="QuestPDF" Version="2025.7.3" />

    <!-- Razor template engine -->
    <PackageReference Include="RazorLight" Version="2.3.1" />

    <!-- MVVM helpers -->
    <PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />

    <!-- Logging UI sink -->
    <PackageReference Include="Serilog.Sinks.ObservableCollection" Version="1.0.0" />

  </ItemGroup>

  <!-- =============================================
       Internal Project References
       ============================================= -->
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Cli\Aegis.Cli.csproj" />
    <ProjectReference Include="..\Aegis.Core\Aegis.Architecture.csproj" />
    <ProjectReference Include="..\Aegis.Infrastructure\Aegis.Infrastructure.csproj" />
    <ProjectReference Include="..\Aegis.Sdk\Aegis.Sdk.csproj" />
    <ProjectReference Include="..\Aegis.Shared\Aegis.Shared.csproj" />
  </ItemGroup>

</Project>
