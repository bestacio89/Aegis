<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared build configuration -->



  <!-- =============================================
       AEGIS Wpf FRONTEND — Desktop Dashboard
       ============================================= -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWpf>true</UseWpf>

    <!-- Inherit base TargetFramework from Directory.Build.props -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>

    <AssemblyName>Aegis.App.Wpf</AssemblyName>
    <RootNamespace>Aegis.App.Wpf</RootNamespace>
    <Description>
      Wpf Dashboard for Aegis — visualization of architecture audits, rule results, and reports.
    </Description>
  </PropertyGroup>

  <!-- =============================================
       UI / Views
       ============================================= -->
  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>
  
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <!-- =============================================
       Dependencies (explicit now)
       ============================================= -->
  <ItemGroup>
    <!-- Wpf UI framework -->
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />

    <!-- MVVM support -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Logging -->
    <PackageReference Include="Franz.Common.Logging" Version="1.6.14" />
       


    <!-- Dependency injection -->
    <PackageReference Include="Franz.Common.DependencyInjection" Version="1.6.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.3" />
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />
    <PackageReference Include="Serilog.Sinks.ObservableCollection" Version="1.0.0" />
  </ItemGroup>

  <!-- =============================================
       Internal References
       ============================================= -->
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Cli\Aegis.Cli.csproj" />
    <ProjectReference Include="..\Aegis.Core\Aegis.Core.csproj" />
    <ProjectReference Include="..\Aegis.Infrastructure\Aegis.Infrastructure.csproj" />
    <ProjectReference Include="..\Aegis.Sdk\Aegis.Sdk.csproj" />
    <ProjectReference Include="..\Aegis.Shared\Aegis.Shared.csproj" />
  </ItemGroup>

</Project>
