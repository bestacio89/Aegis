<Window x:Class="Aegis.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Aegis Architecture Shell"
        Width="1300"
        Height="800"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Consolas">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Grid.ColumnSpan="4"
                Background="#252526"
                Padding="8">

            <DockPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                    <TextBlock Text="Repo:"
                               Foreground="#888"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <TextBox Width="360"
                             Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Background="#1E1E1E"
                             Foreground="White"/>

                    <Button Content="Browse"
                            Command="{Binding SelectRepositoryCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Analyze"
                            Command="{Binding RunAnalysisCommand}"/>

                    <Button Content="Export"
                            Command="{Binding ExportResultsCommand}"/>

                    <Button Content="Clear Logs"
                            Command="{Binding ClearLogsCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <TextBlock Text="{Binding AnalysisProgress, StringFormat={}{0:F0}%}"
                               Foreground="#AAA"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- LEFT BAR -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#1E1E1E"
                BorderBrush="#333"
                BorderThickness="0,0,1,0">

            <StackPanel>

                <Button Content="📊"
                        Command="{Binding ShowSectionWorkspaceCommand}"
                        Height="50"/>

                <Button Content="🧱"
                        Command="{Binding ShowLayerWorkspaceCommand}"
                        Height="50" Click="Button_Click"/>

                <Button Content="⚖"
                        Command="{Binding ShowRuleWorkspaceCommand}"
                        Height="50"/>

                <Button Content="📄"
                        Command="{Binding ShowReportVisualizationCommand}"
                        Height="50"/>

            </StackPanel>

        </Border>

        <!-- NAV -->


        <!-- WORKSPACE -->
        <Border Grid.Column="1"
                Background="#252526" Grid.ColumnSpan="2" Margin="0,34,0,0" Grid.RowSpan="2">

            <ContentControl Content="{Binding ActiveWorkspaceViewModel}"/>
        </Border>

        <!-- INSPECTOR -->
        <Border Grid.Row="1" Grid.Column="3"
                Background="#252526">

            <StackPanel>

                <TextBlock Text="INSPECTOR"
                           Foreground="#888"/>

                <TextBlock Text="{Binding SelectedItem}"
                           TextWrapping="Wrap"/>
            </StackPanel>

        </Border>

        <!-- LOGS -->
        <Border Grid.Row="2" Grid.ColumnSpan="4"
                Background="#1A1A1A">

            <ItemsControl ItemsSource="{Binding Logs}"/>
        </Border>

    </Grid>
</Window>