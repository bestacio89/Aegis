<Window x:Class="Aegis.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aegis.App.Wpf.ViewModels"
        Title="🧠 Aegis Architecture Audit Dashboard"
        Height="600" Width="950"
        Background="#1e1e1e"
        Foreground="White"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <vm:LogColorConverter x:Key="LogColorConverter" />
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="🔍  Analyze" Command="{Binding AnalyzeCommand}" Background="#007ACC"/>
            <Button Content="📦  Export" Command="{Binding ExportCommand}" Background="#0C7D3C"/>
            <Button Content="♻️  Clear Logs" Command="{Binding ReloadCommand}" Background="#444"/>

            <Button Content="📊  Dashboards ▼"
                    Background="#2D2D30"
                    Padding="6,0"
                    Width="140"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0">
                <Button.ContextMenu>
                    <ContextMenu Background="#1e1e1e" Foreground="White">
                        <MenuItem Header="🧩  Section Dashboard"
                                  Command="{Binding OpenSectionDashboardCommand}"/>
                        <MenuItem Header="🧱  Layer Dashboard"
                                  Command="{Binding OpenLayerDashboardCommand}"/>
                        <MenuItem Header="⚖️  Rule Dashboard"
                                  Command="{Binding OpenRuleDashboardCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <!-- 🔹 Progress -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Progress:" VerticalAlignment="Center" Foreground="#AAA" Margin="0,0,8,0"/>
            <ProgressBar Width="300" Height="10" Value="{Binding Progress}" Maximum="100"
                         Background="#333" Foreground="#007ACC" BorderBrush="#555" BorderThickness="1"/>
            <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" VerticalAlignment="Center"
                       Foreground="#AAA" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 🔹 Logs -->
        <Border Grid.Row="2" BorderBrush="#555" BorderThickness="1" Padding="6" Background="#202020">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,1"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding Converter={StaticResource LogColorConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Aegis © Architecture Intelligence Framework"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,6,4"
                   FontSize="10"
                   Foreground="#444"/>
    </Grid>
</Window>
