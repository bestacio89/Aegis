<Window x:Class="Aegis.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aegis.Wpf.ViewModels"
        xmlns:views="clr-namespace:Aegis.Wpf.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        Title="Aegis Architecture Intelligence"
        Width="1680"
        Height="1000"
        MinWidth="1280"
        MinHeight="760"

        Background="{StaticResource Brush.Ink}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Body}">


    <Window.Resources>


        <DataTemplate DataType="{x:Type vm:SectionDashboardViewModel}">
            <views:SectionDashboardView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:LayerDashboardViewModel}">
            <views:LayerDashboardView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:RuleDashboardViewModel}">
            <views:RuleDashboardView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:ReportVisualizationViewModel}">
            <views:ReportVisualizationView/>
        </DataTemplate>


    </Window.Resources>




    <Grid>


        <Grid.RowDefinitions>

            <RowDefinition Height="88"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="34"/>

        </Grid.RowDefinitions>



        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="76"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>





        <!-- HEADER -->


        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,0,0,1">


            <Grid Margin="20,0">


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="260"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>





                <!-- BRAND -->


                <StackPanel VerticalAlignment="Center">


                    <TextBlock Text="AEGIS"
                               FontSize="28"
                               FontWeight="Bold"/>


                    <TextBlock Text="Architecture Intelligence Platform"
                               Style="{StaticResource Text.Eyebrow}"/>


                </StackPanel>






                <!-- REPOSITORY -->


                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">


                    <TextBlock Text="Repository"
                               Style="{StaticResource Text.Eyebrow}"/>



                    <DockPanel Margin="0,6,0,0">


                        <Button Content="Browse"
                                DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Height="32"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding SelectRepositoryCommand}"/>



                        <Border Height="32"
                                Background="{StaticResource Brush.Ink}"
                                BorderBrush="{StaticResource Brush.Line}"
                                BorderThickness="1"
                                Padding="10,0">


                            <TextBlock Text="{Binding RepositoryPath}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>


                        </Border>


                    </DockPanel>


                </StackPanel>






                <!-- ACTIONS -->


                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">


                    <Button Content="Analyze"
                            Height="34"
                            Width="100"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding RunAnalysisCommand}"/>


                    <ComboBox Width="120"
                              Height="34"
                              Margin="10,0"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}"/>


                    <Button Content="Export"
                            Height="34"
                            Width="90"
                            Command="{Binding ExportResultsCommand}"/>



                    <ProgressBar Width="150"
                                 Height="10"
                                 Margin="20,0,8,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding AnalysisProgress}"
                                 Foreground="{StaticResource Brush.AccentStructural}"/>



                    <TextBlock Text="{Binding AnalysisProgress,StringFormat={}{0:F0}%}"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Eyebrow}"/>


                </StackPanel>


            </Grid>


        </Border>







        <!-- NAVIGATION RAIL -->


        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,0,1,0">


            <StackPanel Margin="0,12">


                <!-- HOME -->


                <Button Style="{StaticResource Button.Icon}"
                        Height="60"
                        ToolTip="Home"
                        Content="&#xE80F;"
                        Command="{Binding ShowHomeCommand}"/>



                <Separator Margin="12,8"/>




                <Button Style="{StaticResource Button.Icon}"
                        Height="60"
                        ToolTip="Sections"
                        Content="&#xE8FD;"
                        Command="{Binding ShowSectionWorkspaceCommand}"/>


                <Button Style="{StaticResource Button.Icon}"
                        Height="60"
                        ToolTip="Layers"
                        Content="&#xE81E;"
                        Command="{Binding ShowLayerWorkspaceCommand}"/>


                <Button Style="{StaticResource Button.Icon}"
                        Height="60"
                        ToolTip="Rules"
                        Content="&#xE8C6;"
                        Command="{Binding ShowRuleWorkspaceCommand}"/>


                <Button Style="{StaticResource Button.Icon}"
                        Height="60"
                        ToolTip="Reports"
                        Content="&#xE8A5;"
                        Command="{Binding ShowReportVisualizationCommand}"/>


            </StackPanel>


        </Border>







        <!-- WORKSPACE -->


        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource Brush.Ink}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1">


            <ContentControl Content="{Binding ActiveWorkspaceViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>


        </Border>







        <!-- STATUS -->


        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="0,1,0,0"
                Padding="12,6">


            <DockPanel>


                <TextBlock Text="{Binding SelectedWorkspace, TargetNullValue=Home}"
                           Style="{StaticResource Text.Eyebrow}"/>


                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding AnalysisProgress,StringFormat=Progress {0:F0}%}"
                           Style="{StaticResource Text.Eyebrow}"/>


            </DockPanel>


        </Border>


    </Grid>


</Window>