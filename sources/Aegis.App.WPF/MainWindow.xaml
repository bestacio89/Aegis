<Window
    x:Class="Aegis.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:architectureVm="clr-namespace:Aegis.Wpf.ViewModels.Architecture"
    xmlns:architectureViews="clr-namespace:Aegis.Wpf.Views.Architecture"
    xmlns:securityVm="clr-namespace:Aegis.Wpf.ViewModels.Security"
    xmlns:securityViews="clr-namespace:Aegis.Wpf.Views.Security"
    xmlns:configurationVm="clr-namespace:Aegis.Wpf.ViewModels.Configuration"
    xmlns:configurationViews="clr-namespace:Aegis.Wpf.Views.Configuration"
    Title="Aegis | Architecture Intelligence"
    Width="1440"
    Height="900"
    MinWidth="1100"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Brush.Ink}"
    Foreground="{StaticResource Brush.TextPrimary}">

    <Window.Resources>

        <!-- Workspace resolution -->

        <DataTemplate
            DataType="{x:Type architectureVm:ArchitectureWorkspaceViewModel}">
            <architectureViews:ArchitectureWorkspaceView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type securityVm:SecurityWorkspaceViewModel}">
            <securityViews:SecurityWorkspaceView />
        </DataTemplate>

        <DataTemplate
            DataType="{x:Type configurationVm:ConfigurationWorkspaceViewModel}">
            <configurationViews:ConfigurationWorkspaceView />
        </DataTemplate>

        <!-- Navigation -->

        <Style
            x:Key="NavigationButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter
                Property="Foreground"
                Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Workspace actions -->

        <Style
            x:Key="ToolbarButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- APPLICATION NAVIGATION                                 -->
        <!-- ====================================================== -->

        <Border
            Grid.Column="0"
            Background="#111923"
            BorderBrush="#293443"
            BorderThickness="0,0,1,0">

            <DockPanel LastChildFill="True">

                <!-- Brand -->

                <StackPanel
                    DockPanel.Dock="Top"
                    Margin="22,26,22,30">

                    <TextBlock
                        Text="AEGIS"
                        FontSize="25"
                        FontWeight="Bold" />

                    <TextBlock
                        Text="ARCHITECTURE INTELLIGENCE"
                        FontSize="9"
                        Margin="1,5,0,0"
                        Opacity="0.65" />
                </StackPanel>

                <!-- Shared project context -->

                <StackPanel
                    DockPanel.Dock="Bottom"
                    Margin="16,12,16,20">

                    <Separator
                        Margin="0,0,0,12"
                        Opacity="0.3" />

                    <TextBlock
                        Text="CURRENT PROJECT"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,0,0,6"
                        Opacity="0.65" />

                    <TextBlock
                        Text="{Binding RepositoryPath}"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding RepositoryPath}"
                        FontSize="11"
                        Opacity="0.8" />

                    <TextBlock
                        Text="{Binding SelectedWorkspace,
                            StringFormat='Workspace: {0}'}"
                        Margin="0,12,0,0"
                        FontSize="11"
                        Opacity="0.65" />
                </StackPanel>

                <!-- Primary navigation -->

                <StackPanel Margin="12,0">

                    <TextBlock
                        Text="WORKSPACES"
                        Margin="12,0,0,10"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Opacity="0.6" />

                    <Button
                        Content="Architecture"
                        Command="{Binding ShowArchitectureWorkspaceCommand}"
                        Style="{StaticResource NavigationButtonStyle}" />

                    <Button
                        Content="Security"
                        Command="{Binding ShowSecurityWorkspaceCommand}"
                        Style="{StaticResource NavigationButtonStyle}" />

                    <Button
                        Content="Configuration"
                        Command="{Binding ShowConfigurationWorkspaceCommand}"
                        Style="{StaticResource NavigationButtonStyle}" />

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ====================================================== -->
        <!-- MAIN APPLICATION AREA                                  -->
        <!-- ====================================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Application header -->

            <Border
                Grid.Row="0"
                Padding="26,16"
                BorderBrush="#293443"
                BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding SelectedWorkspace}"
                            FontSize="20"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Assess, understand, and improve your system."
                            Margin="0,4,0,0"
                            FontSize="12"
                            Opacity="0.65" />

                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Text="AEGIS"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.45" />

                </Grid>
            </Border>

            <!-- ================================================== -->
            <!-- WORKSPACE CONTENT                                  -->
            <!-- ================================================== -->

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Architecture-specific toolbar -->

                <Border
                    Grid.Row="0"
                    Padding="24,14"
                    BorderBrush="#293443"
                    BorderThickness="0,0,0,1">

                    <Border.Style>
                        <Style TargetType="{x:Type Border}">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectedWorkspace}"
                                    Value="Architecture">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>
                            </Style.Triggers>

                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Repository context -->

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                                Text="ASSESSMENT SOURCE"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Opacity="0.65" />

                            <TextBlock
                                Text="{Binding RepositoryPath,
                                    TargetNullValue='No repository selected',
                                    FallbackValue='No repository selected'}"
                                Margin="0,4,12,0"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding RepositoryPath}" />

                        </StackPanel>

                        <!-- Actions -->

                        <WrapPanel
                            Grid.Column="1"
                            VerticalAlignment="Center">

                            <Button
                                Content="Select repository"
                                Command="{Binding SelectRepositoryCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />

                            <Button
                                Content="Run analysis"
                                Command="{Binding RunAnalysisCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />

                            <ComboBox
                                Width="90"
                                Height="34"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding ExportFormats}"
                                SelectedItem="{Binding SelectedExportFormat,
                                    Mode=TwoWay}" />

                            <Button
                                Content="Export report"
                                Command="{Binding ExportResultsCommand}"
                                Style="{StaticResource ToolbarButtonStyle}" />

                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Active workspace is resolved through DataTemplates -->

                <ContentControl
                    Grid.Row="1"
                    Content="{Binding ActiveWorkspaceViewModel}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />

            </Grid>

            <!-- ================================================== -->
            <!-- GLOBAL STATUS                                      -->
            <!-- ================================================== -->

            <Border
                Grid.Row="2"
                Padding="20,9"
                Background="#111923"
                BorderBrush="#293443"
                BorderThickness="0,1,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            Text="Workspace:"
                            FontSize="11"
                            Opacity="0.65" />

                        <TextBlock
                            Text="{Binding SelectedWorkspace}"
                            Margin="6,0,18,0"
                            FontSize="11" />

                        <TextBlock
                            Text="Analysis progress:"
                            FontSize="11"
                            Opacity="0.65" />

                        <ProgressBar
                            Width="140"
                            Height="8"
                            Margin="10,0,6,0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding AnalysisProgress}" />

                        <TextBlock
                            Text="{Binding AnalysisProgress,
                                StringFormat={}{0:F0}%}"
                            FontSize="11"
                            VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        Text="Architecture Intelligence Platform"
                        FontSize="10"
                        VerticalAlignment="Center"
                        Opacity="0.5" />

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
