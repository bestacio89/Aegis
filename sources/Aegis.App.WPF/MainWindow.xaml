<Window x:Class="Aegis.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:vm="clr-namespace:Aegis.App.Wpf.ViewModels"
        xmlns:views="clr-namespace:Aegis.App.Wpf.Views"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        mc:Ignorable="d"

        Title="Aegis Architecture Shell"
        Width="1400"
        Height="850"

        Background="#181818"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI">


    <Window.Resources>


        <!-- ================= VIEW RESOLUTION ================= -->


        <DataTemplate DataType="{x:Type vm:SectionDashboardViewModel}">
            <views:SectionDashboardView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:LayerDashboardViewModel}">
            <views:LayerDashboardView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:RuleDashboardViewModel}">
            <views:RuleDashboardView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type vm:ReportVisualizationViewModel}">
            <views:ReportVisualizationView/>
        </DataTemplate>



        <!-- ================= COLORS ================= -->


        <SolidColorBrush x:Key="AegisBackground"
                         Color="#181818"/>


        <SolidColorBrush x:Key="AegisPanel"
                         Color="#252526"/>


        <SolidColorBrush x:Key="AegisBorder"
                         Color="#3A3A3A"/>


        <SolidColorBrush x:Key="AegisAccent"
                         Color="#4CAF50"/>




        <!-- ================= BUTTON STYLE ================= -->


        <Style TargetType="Button">

            <Setter Property="Background"
                    Value="#333333"/>

            <Setter Property="Foreground"
                    Value="#E0E0E0"/>

            <Setter Property="BorderBrush"
                    Value="#444444"/>

            <Setter Property="Padding"
                    Value="10,6"/>

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>




        <!-- ================= TEXTBOX STYLE ================= -->


        <Style TargetType="TextBox">

            <Setter Property="Background"
                    Value="#1E1E1E"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#444444"/>

            <Setter Property="Padding"
                    Value="6"/>

        </Style>



        <!-- ================= COMBO ITEM STYLE ================= -->


        <Style TargetType="ComboBoxItem">

            <Setter Property="Background"
                    Value="#252526"/>

            <Setter Property="Foreground"
                    Value="#E0E0E0"/>

            <Setter Property="Padding"
                    Value="8,6"/>


            <Style.Triggers>


                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3A3A3A"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>



                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#4CAF50"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>


            </Style.Triggers>

        </Style>


    </Window.Resources>




    <Grid>


        <Grid.RowDefinitions>

            <RowDefinition Height="70"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="180"/>

        </Grid.RowDefinitions>




        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="70"/>

            <ColumnDefinition Width="260"/>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="320"/>

        </Grid.ColumnDefinitions>





        <!-- ================= HEADER ================= -->


        <Border Grid.Row="0"
                Grid.ColumnSpan="4"

                Background="{StaticResource AegisPanel}"

                BorderBrush="{StaticResource AegisBorder}"

                BorderThickness="0,0,0,1"

                Padding="12">


            <Grid>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>




                <!-- Repository -->

                <StackPanel Orientation="Horizontal">


                    <TextBlock Text="Repository"

                               Foreground="#AAAAAA"

                               VerticalAlignment="Center"

                               Margin="0,0,10,0"/>



                    <TextBox Width="360"

                             Text="{Binding RepositoryPath}"

                             IsReadOnly="True"/>



                    <Button Content="Browse"

                            Command="{Binding SelectRepositoryCommand}"/>


                </StackPanel>
                <!-- Analysis actions -->

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="20,0">


                    <Button Content="Analyze"
                            Command="{Binding RunAnalysisCommand}"/>



                    <!-- Corrected Export Selector -->

                    <ComboBox Width="120"
                              Height="32"
                              Margin="4"
                              Background="#1E1E1E"
                              Foreground="Indigo"
                              BorderBrush="#444444"
                              BorderThickness="1"
                              Padding="6"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}">


                        <ComboBox.ItemContainerStyle>


                            <Style TargetType="ComboBoxItem">


                                <Setter Property="Background"
                                        Value="#252526"/>


                                <Setter Property="Foreground"
                                        Value="#E0E0E0"/>


                                <Setter Property="Padding"
                                        Value="8,6"/>



                                <Style.Triggers>


                                    <Trigger Property="IsMouseOver"
                                             Value="True">


                                        <Setter Property="Background"
                                                Value="#3A3A3A"/>


                                        <Setter Property="Foreground"
                                                Value="White"/>


                                    </Trigger>




                                    <Trigger Property="IsSelected"
                                             Value="True">


                                        <Setter Property="Background"
                                                Value="#4CAF50"/>


                                        <Setter Property="Foreground"
                                                Value="White"/>


                                    </Trigger>


                                </Style.Triggers>


                            </Style>


                        </ComboBox.ItemContainerStyle>


                    </ComboBox>




                    <Button Content="Export"

                            Command="{Binding ExportResultsCommand}"/>




                    <Button Content="Clear"

                            Command="{Binding ClearLogsCommand}"/>


                </StackPanel>






                <!-- Progress -->

                <StackPanel Grid.Column="3"

                            Width="220">


                    <TextBlock Text="Analysis Progress"

                               Foreground="#AAAAAA"

                               FontSize="11"/>



                    <ProgressBar Height="14"

                                 Minimum="0"

                                 Maximum="100"

                                 Value="{Binding AnalysisProgress}"

                                 Foreground="{StaticResource AegisAccent}"

                                 Background="#111111"/>



                    <TextBlock HorizontalAlignment="Right"

                               Foreground="#AAAAAA"

                               Text="{Binding AnalysisProgress,StringFormat={}{0:F0}%}"/>


                </StackPanel>


            </Grid>


        </Border>






        <!-- ================= NAVIGATION ================= -->


        <Border Grid.Row="1"

                Grid.Column="0"

                Background="#151515">


            <StackPanel>


                <Button Height="55"

                        FontFamily="Segoe MDL2 Assets"

                        Content="&#xE8FD;"

                        ToolTip="Sections"

                        Command="{Binding ShowSectionWorkspaceCommand}"/>



                <Button Height="55"

                        FontFamily="Segoe MDL2 Assets"

                        Content="&#xE81E;"

                        ToolTip="Layers"

                        Command="{Binding ShowLayerWorkspaceCommand}"/>



                <Button Height="55"

                        FontFamily="Segoe MDL2 Assets"

                        Content="&#xE74C;"

                        ToolTip="Rules"

                        Command="{Binding ShowRuleWorkspaceCommand}"/>



                <Button Height="55"

                        FontFamily="Segoe MDL2 Assets"

                        Content="&#xE8A5;"

                        ToolTip="Report"

                        Command="{Binding ShowReportVisualizationCommand}"/>


            </StackPanel>


        </Border>







        <!-- ================= WORKSPACE ================= -->


        <Border Grid.Row="1"

                Grid.Column="1"

                Grid.ColumnSpan="2"

                Background="{StaticResource AegisPanel}"

                BorderBrush="{StaticResource AegisBorder}"

                BorderThickness="1">


            <ContentControl Content="{Binding ActiveWorkspaceViewModel}"

                            HorizontalContentAlignment="Stretch"

                            VerticalContentAlignment="Stretch"/>


        </Border>







        <!-- ================= INSPECTOR ================= -->


        <Border Grid.Row="1"

                Grid.Column="3"

                Background="{StaticResource AegisPanel}"

                Padding="12">


            <StackPanel>


                <TextBlock Text="INSPECTOR"

                           FontWeight="Bold"

                           Foreground="#AAAAAA"/>



                <Separator Margin="0,10"/>



                <TextBlock Text="{Binding SelectedItem}"

                           TextWrapping="Wrap"/>


            </StackPanel>


        </Border>







        <!-- ================= LOG CONSOLE ================= -->


        <Border Grid.Row="2"

                Grid.ColumnSpan="4"

                Background="#111111"

                BorderBrush="{StaticResource AegisBorder}"

                BorderThickness="1">


            <ListBox ItemsSource="{Binding Logs}"

                     Background="Transparent"

                     Foreground="#D0D0D0"

                     BorderThickness="0"

                     FontFamily="Consolas"

                     VirtualizingPanel.IsVirtualizing="True"

                     VirtualizingPanel.VirtualizationMode="Recycling"/>


        </Border>





    </Grid>


</Window>