<Window x:Class="Aegis.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:Aegis.App.Wpf.ViewModels"
        Title="🧠 Aegis Architecture Shell"
        Width="1300"
        Height="800"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <vm:LogColorConverter x:Key="LogColorConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ================= TOP BAR ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="4"
                Background="#252526"
                Padding="8">

            <DockPanel LastChildFill="False">

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">

                    <TextBlock Text="Repo:"
                               Foreground="#888"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <TextBox Width="360"
                             Text="{Binding RepositoryPath}"
                             IsReadOnly="True"
                             Background="#1E1E1E"
                             Foreground="White"
                             BorderBrush="#444"
                             Padding="6,2"/>

                    <Button Content="Browse"
                            Command="{Binding SelectRepositoryCommand}"
                            Margin="6,0,0,0"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Analyze"
                            Command="{Binding RunAnalysisCommand}"
                            Background="#007ACC"/>

                    <Button Content="Export"
                            Command="{Binding ExportResultsCommand}"/>

                    <Button Content="Clear Logs"
                            Command="{Binding ClearLogsCommand}"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <TextBlock Text="{Binding AnalysisProgress, StringFormat={}{0:F0}%}"
                               Foreground="#AAA"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ================= ACTIVITY BAR ================= -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#1E1E1E"
                BorderBrush="#333"
                BorderThickness="0,0,1,0">

            <StackPanel VerticalAlignment="Top">

                <Button Content="📊"
                        ToolTip="Sections"
                        Command="{Binding ShowSectionWorkspaceCommand}"
                        Height="50"
                        FontSize="18"/>

                <Button Content="🧱"
                        ToolTip="Layers"
                        Command="{Binding ShowLayerWorkspaceCommand}"
                        Height="50"
                        FontSize="18"/>

                <Button Content="⚖"
                        ToolTip="Rules"
                        Command="{Binding ShowRuleWorkspaceCommand}"
                        Height="50"
                        FontSize="18"/>

            </StackPanel>

        </Border>

        <!-- ================= SIDE NAV ================= -->
        <Border Grid.Row="1" Grid.Column="1"
                Style="{StaticResource PanelStyle}">

            <StackPanel>

                <TextBlock Text="CONTEXT"
                           Foreground="#888"
                           Margin="0,0,0,8"/>

                <ListBox ItemsSource="{Binding Workspaces}"
                         SelectedItem="{Binding SelectedWorkspace}"
                         Background="#1E1E1E"
                         Foreground="White"/>

            </StackPanel>

        </Border>

        <!-- ================= WORKSPACE ================= -->
        <Border Grid.Row="1" Grid.Column="2"
                Style="{StaticResource PanelStyle}">

            <ContentControl Content="{Binding ActiveWorkspaceViewModel}"/>

        </Border>

        <!-- ================= INSPECTOR ================= -->
        <Border Grid.Row="1" Grid.Column="3"
                Style="{StaticResource PanelStyle}">

            <StackPanel>

                <TextBlock Text="INSPECTOR"
                           Foreground="#888"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding SelectedItem.Title}"
                           FontSize="16"
                           Foreground="White"/>

                <TextBlock Text="{Binding SelectedItem.Description}"
                           Foreground="#AAA"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>

                <Separator Margin="0,10"/>

                <ItemsControl ItemsSource="{Binding SelectedItem.Properties}"/>

            </StackPanel>

        </Border>

        <!-- ================= CONSOLE ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="4"
                Background="#1A1A1A"
                BorderBrush="#333"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Logs}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{Binding Converter={StaticResource LogColorConverter}}"
                                       FontFamily="Consolas"
                                       Margin="2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>