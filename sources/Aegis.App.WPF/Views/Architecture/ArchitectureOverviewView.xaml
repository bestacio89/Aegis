<UserControl x:Class="Aegis.Wpf.Views.Architecture.ArchitectureOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Ink}"
             Foreground="{StaticResource Brush.TextPrimary}"
             FontFamily="{StaticResource Font.Body}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Card.Structural}" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="ARCHITECTURE ASSESSMENT" Style="{StaticResource Text.Eyebrow}"
                       Foreground="{StaticResource Brush.AccentStructural}"/>
            <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Text.Title}" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding AssessmentMessage}" Foreground="{StaticResource Brush.TextMuted}"
                       TextWrapping="Wrap" Margin="0,8,12,0" MaxWidth="900"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource Brush.PanelElevated}"
                  BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                  CornerRadius="5" Padding="12,8" VerticalAlignment="Top" Margin="12,0,0,0">
            <TextBlock Text="{Binding AssessmentStatus}" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.AccentStructural}" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Border>

      <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,6">
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="94">
          <StackPanel><TextBlock Text="FINDINGS" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding Findings}" Style="{StaticResource Text.KpiValue}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="94">
          <StackPanel><TextBlock Text="BLOCKER / CRITICAL" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding CriticalFindings}" Style="{StaticResource Text.KpiValue}"
                       Foreground="{StaticResource Brush.StatusCritical}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="94">
          <StackPanel><TextBlock Text="RULES EVALUATED" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding RulesEvaluated}" Style="{StaticResource Text.KpiValue}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="94">
          <StackPanel><TextBlock Text="RULE COVERAGE" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding RuleCoverage}" Style="{StaticResource Text.KpiValue}"
                       Foreground="{StaticResource Brush.AccentStructural}"/></StackPanel>
        </Border>
      </UniformGrid>

      <Grid Grid.Row="2" Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card.Structural}">
          <StackPanel><TextBlock Text="HEALTH INDEX" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding HealthIndex}" Style="{StaticResource Text.KpiValue}"/>
            <TextBlock Text="Aggregated architecture health; interpret alongside coverage."
                       Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card.Structural}">
          <StackPanel><TextBlock Text="WEIGHTED COMPLIANCE" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding WeightedCompliance}" Style="{StaticResource Text.KpiValue}"/>
            <TextBlock Text="Weighted checks that passed, distinct from the health index."
                       Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card.Structural}">
          <StackPanel><TextBlock Text="FILES SCANNED" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding FilesScanned}" Style="{StaticResource Text.KpiValue}"/>
            <TextBlock Text="Excluded path entries" Foreground="{StaticResource Brush.TextMuted}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ExcludedPaths}" Foreground="{StaticResource Brush.TextMuted}"
                       TextWrapping="Wrap"/></StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource Card.Structural}" Margin="0">
        <StackPanel>
          <TextBlock Text="RECOMMENDED NEXT ACTION" Style="{StaticResource Text.Eyebrow}"
                     Foreground="{StaticResource Brush.AccentStructural}"/>
          <TextBlock Text="{Binding NextAction}" FontSize="15" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock Text="Use Rules &amp; Metrics for aggregate evaluation, Findings to investigate individual violations, and Reports for the full assessment summary."
                     Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>