<UserControl
    x:Class="Aegis.Wpf.Views.Architecture.DependencyGraphView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource Brush.Ink}"
    Foreground="{StaticResource Brush.TextPrimary}"
    FontFamily="{StaticResource Font.Body}">

    <UserControl.Resources>
        <Style x:Key="GraphNodeButton" TargetType="Button">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NodeBorder"
                                Background="{StaticResource Brush.PanelElevated}"
                                BorderBrush="{StaticResource Brush.Line}"
                                BorderThickness="1" CornerRadius="5" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                                <TextBlock Grid.Row="1" Text="{Binding Layer}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="10" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Layer}" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding RelationshipCount, StringFormat={}{0} relationships}"
                                           Foreground="{StaticResource Brush.AccentStructural}"
                                           FontSize="9" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NodeBorder" Property="BorderBrush"
                                        Value="{StaticResource Brush.AccentStructural}" />
                                <Setter TargetName="NodeBorder" Property="Background"
                                        Value="{StaticResource Brush.Panel}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="NodeBorder" Property="BorderBrush"
                                        Value="{StaticResource Brush.AccentStructural}" />
                                <Setter TargetName="NodeBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="NodeBorder" Property="Background"
                                        Value="{StaticResource Brush.Panel}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DEPENDENCY GRAPH" Style="{StaticResource Text.Eyebrow}"
                               Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Text.Title}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Explore detector-reported source-to-target dependencies across the system. Select a component to isolate its incoming and outgoing relationships."
                        Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                        Margin="0,6,12,0" TextWrapping="Wrap" MaxWidth="900" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Brush.PanelElevated}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="VISIBLE / TOTAL" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding FilteredDependencies, StringFormat={}{0:N0}}"
                                   Style="{StaticResource Text.KpiValue}" FontSize="22" />
                        <TextBlock Text="{Binding TotalDependencies, StringFormat='of {0:N0} relationships'}"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="-6,0,-6,4">
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="76">
                <StackPanel>
                    <TextBlock Text="COMPONENTS" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding ComponentCount}" Style="{StaticResource Text.KpiValue}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="76">
                <StackPanel>
                    <TextBlock Text="ARCHITECTURE LAYERS" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding LayerCount}" Style="{StaticResource Text.KpiValue}" FontSize="24" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="76">
                <StackPanel>
                    <TextBlock Text="DIRECTED RELATIONSHIPS" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding TotalDependencies}" Style="{StaticResource Text.KpiValue}" FontSize="24" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search components, layers, dependency types, or evidence files"
                     MinHeight="38" Padding="12,8" Margin="0,0,10,0"
                     Background="{StaticResource Brush.PanelElevated}"
                     Foreground="{StaticResource Brush.TextPrimary}"
                     BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                     VerticalContentAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding LayerFilters}"
                      SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                      MinHeight="38" Margin="0,0,10,0" Padding="8,4"
                      Background="{StaticResource Brush.PanelElevated}"
                      Foreground="{StaticResource Brush.TextPrimary}"
                      BorderBrush="{StaticResource Brush.Line}"
                      VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="Clear filters"
                    Command="{Binding ClearFiltersCommand}"
                    Padding="14,8" MinHeight="38"
                    Background="{StaticResource Brush.PanelElevated}"
                    Foreground="{StaticResource Brush.TextPrimary}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                    CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="ARROWS REPRESENT DETECTOR-REPORTED SOURCE → TARGET DEPENDENCIES"
                               Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="9" FontWeight="SemiBold" Margin="8,4,8,10" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <Canvas Width="{Binding GraphWidth}" Height="{Binding GraphHeight}"
                                Background="{StaticResource Brush.Panel}">
                            <ItemsControl ItemsSource="{Binding GraphEdges}"
                                          Width="{Binding GraphWidth}" Height="{Binding GraphHeight}"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding EvidenceLabel}">
                                            <Path Data="{Binding LineGeometry}" Stretch="None"
                                                  Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.5" />
                                            <Path Data="{Binding ArrowGeometry}" Stretch="None"
                                                  Stroke="{StaticResource Brush.TextMuted}"
                                                  Fill="{StaticResource Brush.TextMuted}" StrokeThickness="1.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding GraphLayerHeaders}"
                                          Width="{Binding GraphWidth}" Height="{Binding GraphHeight}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="18" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Width="196"
                                                   Foreground="{StaticResource Brush.AccentStructural}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding GraphNodes}"
                                          Width="{Binding GraphWidth}" Height="{Binding GraphHeight}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GraphNodeButton}"
                                                Command="{Binding DataContext.SelectGraphNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Select to isolate incoming and outgoing relationships">
                                            <TextBlock Text="{Binding Name}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{StaticResource Brush.PanelElevated}" Padding="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GraphNodes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="No dependency graph to display" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="No relationships match the current filters. Clear the filters or load an assessment that provides dependency edges."
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,13" Background="{StaticResource Brush.PanelElevated}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="COMPONENT INSPECTOR" Style="{StaticResource Text.Eyebrow}"
                                       Foreground="{StaticResource Brush.AccentStructural}" />
                            <TextBlock Text="{Binding SelectedGraphNode.Name, TargetNullValue='Select a component'}"
                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding SelectedGraphNode.Layer, TargetNullValue='Select a node to inspect its layer'}"
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">
                            <TextBlock Text="INCOMING RELATIONSHIPS" Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedGraphNode.IncomingCount, TargetNullValue='—'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="OUTGOING RELATIONSHIPS" Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedGraphNode.OutgoingCount, TargetNullValue='—'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="GRAPH SEMANTICS" Foreground="{StaticResource Brush.TextMuted}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,18,0,4" />
                            <TextBlock Text="Edges preserve the source-to-target direction reported by the detector. Repeated source-target pairs are represented as one visual edge; the relationship ledger retains the individual records."
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
