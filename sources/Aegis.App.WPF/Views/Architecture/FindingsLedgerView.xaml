<UserControl
    x:Class="Aegis.Wpf.Views.Architecture.FindingsLedgerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Aegis.Wpf.Converters"
    Background="{StaticResource Brush.Ink}"
    Foreground="{StaticResource Brush.TextPrimary}"
    FontFamily="{StaticResource Font.Body}">

    <UserControl.Resources>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />

        <Style x:Key="FindingDetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style x:Key="FindingDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Text="FINDINGS LEDGER"
                        Style="{StaticResource Text.Eyebrow}"
                        Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock
                        Text="{Binding ProjectName}"
                        Style="{StaticResource Text.Title}"
                        Margin="0,5,0,0"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="Select a finding to inspect its source, evidence, evaluator provenance, and recommended remediation."
                        Foreground="{StaticResource Brush.TextMuted}"
                        FontSize="12"
                        Margin="0,6,12,0"
                        TextWrapping="Wrap"
                        MaxWidth="900" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Background="{StaticResource Brush.PanelElevated}"
                    BorderBrush="{StaticResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="VISIBLE / TOTAL" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock
                            Text="{Binding FilteredFindings, StringFormat={}{0:N0}}"
                            Style="{StaticResource Text.KpiValue}"
                            FontSize="22" />
                        <TextBlock
                            Text="{Binding TotalFindings, StringFormat='of {0:N0} findings'}"
                            Foreground="{StaticResource Brush.TextMuted}"
                            FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="6" Margin="-6,0,-6,4">
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
                <StackPanel>
                    <TextBlock Text="BLOCKER" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding BlockerCount}" Style="{StaticResource Text.KpiValue}" FontSize="23"
                               Foreground="{StaticResource Brush.StatusBlocker}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
                <StackPanel>
                    <TextBlock Text="CRITICAL" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource Text.KpiValue}" FontSize="23"
                               Foreground="{StaticResource Brush.StatusCritical}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
                <StackPanel>
                    <TextBlock Text="HIGH" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding HighCount}" Style="{StaticResource Text.KpiValue}" FontSize="23"
                               Foreground="{StaticResource Brush.StatusWarning}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
                <StackPanel>
                    <TextBlock Text="MEDIUM" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding MediumCount}" Style="{StaticResource Text.KpiValue}" FontSize="23" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
                <StackPanel>
                    <TextBlock Text="LOW" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding LowCount}" Style="{StaticResource Text.KpiValue}" FontSize="23" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
                <StackPanel>
                    <TextBlock Text="INFO" Style="{StaticResource Text.Eyebrow}" />
                    <TextBlock Text="{Binding InfoCount}" Style="{StaticResource Text.KpiValue}" FontSize="23" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Search rule, category, severity, source, message, recommendation, or evidence"
                MinHeight="38"
                Padding="12,8"
                Margin="0,0,10,0"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                VerticalContentAlignment="Center" />

            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding SeverityFilters}"
                SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                MinHeight="38"
                Margin="0,0,10,0"
                Padding="8,4"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}"
                VerticalContentAlignment="Center" />

            <Button
                Grid.Column="2"
                Content="Clear filters"
                Command="{Binding ClearFilterCommand}"
                Padding="14,8"
                MinHeight="38"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                <DataGrid
                    ItemsSource="{Binding FindingsView}"
                    SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    HeadersVisibility="Column"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    RowDetailsVisibilityMode="Collapsed"
                    Style="{StaticResource Grid.Ledger}"
                    ColumnHeaderStyle="{StaticResource Grid.LedgerHeader}"
                    RowStyle="{StaticResource Grid.LedgerRow}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Severity" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"
                                        CornerRadius="3"
                                        Padding="7,3"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Text="{Binding Severity}"
                                            Foreground="{StaticResource Brush.Ink}"
                                            FontWeight="SemiBold"
                                            FontSize="10" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="170" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115" />
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="190" />
                        <DataGridTextColumn Header="Line" Binding="{Binding LineNumber}" Width="55" />
                        <DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border
                Grid.Column="2"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Line}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="16,13"
                        Background="{StaticResource Brush.PanelElevated}"
                        BorderBrush="{StaticResource Brush.Line}"
                        BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="INVESTIGATION" Style="{StaticResource Text.Eyebrow}"
                                       Foreground="{StaticResource Brush.AccentStructural}" />
                            <TextBlock Text="{Binding SelectedFinding.RuleName, TargetNullValue='Select a finding'}"
                                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding SelectedFinding.RuleId}" Foreground="{StaticResource Brush.TextMuted}"
                                       FontFamily="{StaticResource Font.Data}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,4,16,16">
                            <TextBlock Text="SEVERITY / CATEGORY" Style="{StaticResource FindingDetailLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedFinding.Severity, TargetNullValue='—'}"
                                           Style="{StaticResource FindingDetailValue}" FontWeight="SemiBold" />
                                <TextBlock Text="  ·  " Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SelectedFinding.Category, TargetNullValue='—'}"
                                           Style="{StaticResource FindingDetailValue}" />
                            </StackPanel>

                            <TextBlock Text="DOMAIN / EVALUATOR" Style="{StaticResource FindingDetailLabel}" />
                            <TextBlock Text="{Binding SelectedFinding.Domain, TargetNullValue='Not supplied'}"
                                       Style="{StaticResource FindingDetailValue}" />
                            <TextBlock Text="{Binding SelectedFinding.DetectedBy, TargetNullValue='Not supplied'}"
                                       Style="{StaticResource FindingDetailValue}" />

                            <TextBlock Text="SOURCE LOCATION" Style="{StaticResource FindingDetailLabel}" />
                            <TextBlock Text="{Binding SelectedFinding.FilePath, TargetNullValue='No source file supplied'}"
                                       Style="{StaticResource FindingDetailValue}" FontFamily="{StaticResource Font.Data}" />
                            <TextBlock Text="{Binding SelectedFinding.Namespace}" Style="{StaticResource FindingDetailValue}" />
                            <TextBlock Text="{Binding SelectedFinding.LineNumber, StringFormat='Line {0}', TargetNullValue='Line unavailable'}"
                                       Style="{StaticResource FindingDetailValue}" />

                            <TextBlock Text="FINDING" Style="{StaticResource FindingDetailLabel}" />
                            <TextBlock Text="{Binding SelectedFinding.Message, TargetNullValue='Select a row to inspect its finding.'}"
                                       Style="{StaticResource FindingDetailValue}" />

                            <TextBlock Text="RECOMMENDED REMEDIATION" Style="{StaticResource FindingDetailLabel}" />
                            <TextBlock Text="{Binding SelectedFinding.Recommendation, TargetNullValue='No recommendation was supplied by the evaluator.'}"
                                       Style="{StaticResource FindingDetailValue}" />

                            <TextBlock Text="CODE EVIDENCE" Style="{StaticResource FindingDetailLabel}" />
                            <Border Background="{StaticResource Brush.Ink}" BorderBrush="{StaticResource Brush.Line}"
                                    BorderThickness="1" CornerRadius="3" Padding="10">
                                <TextBlock Text="{Binding SelectedFinding.CodeSnippet, TargetNullValue='No code snippet was captured.'}"
                                           FontFamily="{StaticResource Font.Data}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="EVIDENCE ITEMS" Style="{StaticResource FindingDetailLabel}" />
                            <ItemsControl ItemsSource="{Binding SelectedFinding.Evidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                                                Padding="0,7">
                                            <TextBlock Text="{Binding}" Style="{StaticResource FindingDetailValue}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="DETECTION" Style="{StaticResource FindingDetailLabel}" />
                            <TextBlock Text="{Binding SelectedFinding.Timestamp, TargetNullValue='Timestamp unavailable'}"
                                       Style="{StaticResource FindingDetailValue}" />
                            <TextBlock Text="{Binding SelectedFinding.AnalyzerVersion, StringFormat='Analyzer {0}'}"
                                       Style="{StaticResource FindingDetailValue}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="2"
                        Padding="12"
                        BorderBrush="{StaticResource Brush.Line}"
                        BorderThickness="0,1,0,0">
                        <Button
                            Content="Copy investigation details"
                            Command="{Binding CopySelectedFindingCommand}"
                            Style="{StaticResource Button.Primary}"
                            HorizontalAlignment="Stretch"
                            MinHeight="36" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>