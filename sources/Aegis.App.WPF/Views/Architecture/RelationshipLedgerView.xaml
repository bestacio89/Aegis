<UserControl
    x:Class="Aegis.Wpf.Views.Architecture.RelationshipLedgerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource Brush.Ink}"
    Foreground="{StaticResource Brush.TextPrimary}"
    FontFamily="{StaticResource Font.Body}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RELATIONSHIP LEDGER" Style="{StaticResource Text.Eyebrow}"
                               Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Text.Title}"
                               Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Inspect the detector's individual dependency records, source evidence, direction, and layer classification. Each row remains an independent record."
                        Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                        Margin="0,6,12,0" TextWrapping="Wrap" MaxWidth="900" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Brush.PanelElevated}"
                        BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="VISIBLE / TOTAL" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding FilteredDependencies, StringFormat={}{0:N0}}"
                                   Style="{StaticResource Text.KpiValue}" FontSize="22" />
                        <TextBlock Text="{Binding TotalDependencies, StringFormat='of {0:N0} records'}"
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card.Structural}" Margin="0,0,0,10" Padding="14">
            <StackPanel>
                <TextBlock Text="APPLICATION INTEGRATIONS" Style="{StaticResource Text.Eyebrow}"
                           Foreground="{StaticResource Brush.AccentStructural}" />
                <TextBlock Text="Declare runtime relationships between modules when build metadata cannot establish them, such as an Angular client consuming an ASP.NET Core API. These declarations remain separate from detected build dependencies."
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                           Margin="0,5,0,10" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding IntegrationModules}"
                              SelectedItem="{Binding SelectedIntegrationSource, Mode=TwoWay}"
                              DisplayMemberPath="Name" MinHeight="34" Margin="0,0,6,0" ToolTip="Source module" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding IntegrationModules}"
                              SelectedItem="{Binding SelectedIntegrationTarget, Mode=TwoWay}"
                              DisplayMemberPath="Name" MinHeight="34" Margin="0,0,6,0" ToolTip="Target module" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding IntegrationPatterns}"
                              SelectedItem="{Binding SelectedIntegrationPattern, Mode=TwoWay}"
                              MinHeight="34" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding IntegrationProtocols}"
                              SelectedItem="{Binding SelectedIntegrationProtocol, Mode=TwoWay}"
                              MinHeight="34" Margin="0,0,6,0" />
                    <TextBox Grid.Column="4" Text="{Binding IntegrationNotes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="34" Padding="8,6" Margin="0,0,6,0"
                             VerticalContentAlignment="Center" ToolTip="Optional endpoint or rationale" />
                    <Button Grid.Column="5" Content="Add integration"
                            Command="{Binding AddApplicationIntegrationCommand}"
                            Style="{StaticResource Button.Primary}" MinHeight="34" Padding="12,6" />
                </Grid>
                <DataGrid ItemsSource="{Binding ApplicationIntegrations}"
                          SelectedItem="{Binding SelectedApplicationIntegration, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" Height="112" Margin="0,10,0,0"
                          Style="{StaticResource Grid.Ledger}"
                          ColumnHeaderStyle="{StaticResource Grid.LedgerHeader}"
                          RowStyle="{StaticResource Grid.LedgerRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source" Binding="{Binding SourceModuleName}" Width="*" />
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetModuleName}" Width="*" />
                        <DataGridTextColumn Header="Interaction" Binding="{Binding InteractionPattern}" Width="140" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="110" />
                        <DataGridTextColumn Header="Origin" Binding="{Binding EvidenceOrigin}" Width="110" />
                        <DataGridTextColumn Header="Endpoint status" Binding="{Binding EndpointResolutionStatus}" Width="120" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="{Binding IntegrationStatus}" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Remove selected"
                            Command="{Binding RemoveApplicationIntegrationCommand}" Padding="10,5" MinHeight="28"
                            Background="{StaticResource Brush.PanelElevated}" Foreground="{StaticResource Brush.TextPrimary}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Search source, target, layers, dependency type, or evidence file"
                MinHeight="38" Padding="12,8" Margin="0,0,10,0"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                VerticalContentAlignment="Center" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding LayerFilters}"
                SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                MinHeight="38" Margin="0,0,10,0" Padding="8,4"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}"
                VerticalContentAlignment="Center" />
            <ComboBox
                Grid.Column="2"
                ItemsSource="{Binding ScopeFilters}"
                SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                MinHeight="38" Margin="0,0,10,0" Padding="8,4"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}"
                VerticalContentAlignment="Center" />
            <Button
                Grid.Column="3"
                Content="Clear filters"
                Command="{Binding ClearFiltersCommand}"
                Padding="14,8" MinHeight="38"
                Background="{StaticResource Brush.PanelElevated}"
                Foreground="{StaticResource Brush.TextPrimary}"
                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                    CornerRadius="4" Padding="8">
                <Grid>
                    <DataGrid
                    ItemsSource="{Binding DependenciesView}"
                    SelectedItem="{Binding SelectedDependency, Mode=TwoWay}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserReorderColumns="False" CanUserResizeRows="False"
                    CanUserSortColumns="True" SelectionMode="Single"
                    SelectionUnit="FullRow" HeadersVisibility="Column"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    Style="{StaticResource Grid.Ledger}"
                    ColumnHeaderStyle="{StaticResource Grid.LedgerHeader}"
                    RowStyle="{StaticResource Grid.LedgerRow}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Level" Binding="{Binding RelationshipLevel}" Width="135" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                        <DataGridTextColumn Header="Source layer" Binding="{Binding SourceLayer}" Width="110" />
                        <DataGridTextColumn Header="Direction / type" Binding="{Binding DependencyType}" Width="155" />
                        <DataGridTextColumn Header="Relations" Binding="{Binding RelationshipCount}" Width="75" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90" />
                        <DataGridTextColumn Header="Target layer" Binding="{Binding TargetLayer}" Width="110" />
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*" />
                        <DataGridTextColumn Header="Evidence file(s)" Binding="{Binding File}" Width="1.4*" />
                    </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="{StaticResource Brush.PanelElevated}" Padding="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredDependencies}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="No relationship records to display"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="No detector-reported relationships match the current filters. Clear the filters or run an assessment that discovers dependencies."
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,13" Background="{StaticResource Brush.PanelElevated}"
                            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="RELATIONSHIP DETAILS" Style="{StaticResource Text.Eyebrow}"
                                       Foreground="{StaticResource Brush.AccentStructural}" />
                            <TextBlock Text="{Binding SelectedDependency.RelationshipLevel, TargetNullValue='Relationship level'}"
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding SelectedDependency.Source, TargetNullValue='Select a relationship'}"
                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SelectedDependency.Target, StringFormat='→  {0}', TargetNullValue='Select a row in the ledger'}"
                                       Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">
                            <TextBlock Text="RELATIONSHIP COUNT" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.RelationshipCount, TargetNullValue='Not supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="SOURCE LAYER" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.SourceLayer, TargetNullValue='Not classified'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="TARGET LAYER" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.TargetLayer, TargetNullValue='Not classified'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="DEPENDENCY TYPE" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.DependencyType, TargetNullValue='Not supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="SCOPE" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.Scope, TargetNullValue='Not supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="SOURCE PROJECT" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.SourceProjectPath, TargetNullValue='Not supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="11"
                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Data}" />
                            <TextBlock Text="TARGET PROJECT" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.TargetProjectPath, TargetNullValue='Not supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="11"
                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Data}" />
                            <TextBlock Text="RESOLUTION COUNTS" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.ResolvedRelationshipCount, StringFormat='Resolved: {0:N0}'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedDependency.PartiallyResolvedRelationshipCount, StringFormat='Partially resolved: {0:N0}'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedDependency.UnreferencedRelationshipCount, StringFormat='Unreferenced: {0:N0}'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12" />
                            <TextBlock Text="DISCOVERY EVIDENCE FILES" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.File, TargetNullValue='No source file supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="12"
                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Data}" />
                            <TextBlock Text="SEMANTIC SOURCE REFERENCES" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedDependency.EvidenceReferences, TargetNullValue='No exact provider references supplied'}"
                                       Foreground="{StaticResource Brush.TextPrimary}" FontSize="11"
                                       TextWrapping="Wrap" FontFamily="{StaticResource Font.Data}" />
                            <TextBlock
                                Text="Build-module dependencies and compiler-resolved component relationships are shown as distinct evidence levels. Semantic projections aggregate repeated relationships but retain exact run-scoped relationship references, resolution counts, and source files where supplied."
                                Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                                TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="12" BorderBrush="{StaticResource Brush.Line}"
                            BorderThickness="0,1,0,0">
                        <Button Content="Copy relationship details"
                                Command="{Binding CopySelectedDependencyCommand}"
                                Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Stretch" MinHeight="36" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
