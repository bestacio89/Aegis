<UserControl x:Class="Aegis.Wpf.Views.Architecture.RuleDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource Brush.Ink}"
             Foreground="{StaticResource Brush.TextPrimary}"
             FontFamily="{StaticResource Font.Body}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="330"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="RULES &amp; METRICS" Style="{StaticResource Text.Eyebrow}"
                       Foreground="{StaticResource Brush.AccentStructural}"/>
            <TextBlock Text="Evaluation health and aggregate compliance" Style="{StaticResource Text.Title}"
                       Margin="0,5,0,0"/>
            <TextBlock Text="Understand severity distribution and category-level compliance here. Individual findings are isolated in the Findings ledger."
                       Foreground="{StaticResource Brush.TextMuted}" FontSize="12"
                       Margin="0,6,12,0" TextWrapping="Wrap" MaxWidth="900"/>
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource Brush.PanelElevated}"
                  BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                  CornerRadius="4" Padding="12,8" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="PROJECT HEALTH" Style="{StaticResource Text.Eyebrow}"/>
              <TextBlock Text="{Binding ProjectHealth, StringFormat={}{0:0.0}%}"
                         Style="{StaticResource Text.KpiValue}" FontSize="22"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <UniformGrid Grid.Row="1" Columns="5" Margin="-6,0,-6,4">
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="82">
          <StackPanel><TextBlock Text="FINDINGS" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding TotalViolations}" Style="{StaticResource Text.KpiValue}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="82">
          <StackPanel><TextBlock Text="BLOCKERS" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding BlockerCount}" Style="{StaticResource Text.KpiValue}" Foreground="{StaticResource Brush.StatusBlocker}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="82">
          <StackPanel><TextBlock Text="CRITICAL" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource Text.KpiValue}" Foreground="{StaticResource Brush.StatusCritical}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="82">
          <StackPanel><TextBlock Text="HIGH" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding HighCount}" Style="{StaticResource Text.KpiValue}" Foreground="{StaticResource Brush.StatusWarning}"/></StackPanel>
        </Border>
        <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="82">
          <StackPanel><TextBlock Text="MEDIUM" Style="{StaticResource Text.Eyebrow}"/>
            <TextBlock Text="{Binding MediumCount}" Style="{StaticResource Text.KpiValue}"/></StackPanel>
        </Border>
      </UniformGrid>

      <Grid Grid.Row="2" Margin="0,4,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.85*" MinWidth="240"/>
          <ColumnDefinition Width="1.8*" MinWidth="340"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card.Structural}" Margin="6">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Finding severity" Style="{StaticResource Text.SectionTitle}"/>
            <lvc:PieChart Grid.Row="1" Series="{Binding SeveritySeries}" LegendPosition="Right"
                          AnimationsSpeed="0:0:0" MinHeight="250"/>
          </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card.Structural}" Margin="6">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Compliance by category" Style="{StaticResource Text.SectionTitle}"/>
            <lvc:CartesianChart Grid.Row="1" Series="{Binding CategorySeries}"
                                XAxes="{Binding CategoryAxes}" YAxes="{Binding ValueAxes}"
                                Background="Transparent" DrawMarginFrame="{x:Null}"
                                AnimationsSpeed="0:0:0" MinHeight="250"/>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Style="{StaticResource Card.Structural}" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="RULE EVALUATION ACCOUNTING" Style="{StaticResource Text.Eyebrow}"
                     Foreground="{StaticResource Brush.AccentStructural}"/>
          <UniformGrid Columns="4" Margin="-6,8,-6,0">
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="REGISTERED" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding RegisteredRules}" Style="{StaticResource Text.KpiValue}" FontSize="22"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="APPLICABLE" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding ApplicableRules}" Style="{StaticResource Text.KpiValue}" FontSize="22"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="EVALUATED" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding EvaluatedRules}" Style="{StaticResource Text.KpiValue}" FontSize="22" Foreground="{StaticResource Brush.StatusCompliant}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="NOT EVALUATED" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding NotEvaluatedRules}" Style="{StaticResource Text.KpiValue}" FontSize="22" Foreground="{StaticResource Brush.StatusWarning}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="NOT APPLICABLE" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding NotApplicableRules}" Style="{StaticResource Text.KpiValue}" FontSize="22"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="UNSUPPORTED" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding UnsupportedRules}" Style="{StaticResource Text.KpiValue}" FontSize="22" Foreground="{StaticResource Brush.StatusCritical}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="RULE ERRORS" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding RulesWithErrors}" Style="{StaticResource Text.KpiValue}" FontSize="22"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Kpi}" Width="Auto" Height="Auto" MinHeight="72">
              <StackPanel><TextBlock Text="CONTRACT FAILURES" Style="{StaticResource Text.Eyebrow}"/>
                <TextBlock Text="{Binding MetricContractFailures}" Style="{StaticResource Text.KpiValue}" FontSize="22"/></StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Text="{Binding RuleAccountingDetails}" Foreground="{StaticResource Brush.TextMuted}"
                     TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="4" Style="{StaticResource Card.Structural}" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock Text="INTERPRETATION" Style="{StaticResource Text.Eyebrow}"
                     Foreground="{StaticResource Brush.AccentStructural}"/>
          <TextBlock Text="{Binding MostAffectedCategory, StringFormat='Most affected category: {0}'}"
                     FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/>
          <TextBlock Text="A low finding count does not establish compliance when applicable rules were not evaluated. Check evaluation coverage and diagnostics in Overview before treating these aggregates as a verdict."
                     Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"
                     Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
