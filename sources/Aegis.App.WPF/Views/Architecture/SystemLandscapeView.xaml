<UserControl
    x:Class="Aegis.Wpf.Views.Architecture.SystemLandscapeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:archivm="clr-namespace:Aegis.Wpf.ViewModels.Architecture"
    Background="{StaticResource Brush.Ink}"
    Foreground="{StaticResource Brush.TextPrimary}"
    FontFamily="{StaticResource Font.Body}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type archivm:SystemLandscapeRegionViewModel}">
            <Border Background="{StaticResource Brush.PanelElevated}" BorderBrush="{StaticResource Brush.Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="6">
                <StackPanel>
                    <TextBlock Text="{Binding Role}" Style="{StaticResource Text.Eyebrow}" Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="IMPLEMENTATION BOUNDARIES" Style="{StaticResource Text.Eyebrow}" Margin="0,10,0,4" />
                    <ItemsControl ItemsSource="{Binding CodeContainers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Line}"
                                        BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,5,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ImplementationKind}" FontSize="9" Foreground="{StaticResource Brush.TextMuted}" />
                                        <TextBlock Text="{Binding ClassificationSource}" FontSize="8" Foreground="{StaticResource Brush.AccentStructural}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="NESTED COMPONENTS" Style="{StaticResource Text.Eyebrow}" Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Children}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <Border Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="SYSTEM LANDSCAPE" Style="{StaticResource Text.Eyebrow}" Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="{Binding ProjectName}" Style="{StaticResource Text.Title}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding LandscapeDescription}" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding BasePackageLabel}" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="10" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="SYSTEM TOPOLOGY" Style="{StaticResource Text.Eyebrow}"
                               Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="Logical regions establish placement. Code boundaries are nested only when every contributing leaf has one consistent, valid owner."
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,8"
                               TextWrapping="Wrap" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  MaxHeight="720" CanContentScroll="False">
                        <Canvas Width="{Binding TopologyCanvasSize.Width}"
                                Height="{Binding TopologyCanvasSize.Height}"
                                KeyboardNavigation.TabNavigation="Continue">
                            <ItemsControl ItemsSource="{Binding TopologyEdges}" Width="{Binding TopologyCanvasSize.Width}" Height="{Binding TopologyCanvasSize.Height}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="0" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas IsHitTestVisible="False">
                                            <Path Data="{Binding Route}" Stroke="{StaticResource Brush.TextMuted}"
                                                  StrokeThickness="{Binding StrokeThickness}" Opacity="{Binding StrokeOpacity}" />
                                            <Path Data="{Binding ArrowHead}" Fill="{StaticResource Brush.TextMuted}"
                                                  Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="0.8"
                                                  Opacity="{Binding ArrowOpacity}" />
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding TopologyNodes}" Width="{Binding TopologyCanvasSize.Width}" Height="{Binding TopologyCanvasSize.Height}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="{Binding Width}" Height="{Binding Height}" Padding="8"
                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                Background="{StaticResource Brush.Panel}"
                                                Opacity="{Binding VisualOpacity}"
                                                Command="{Binding DataContext.SelectTopologyNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                AutomationProperties.HelpText="{Binding AutomationHelpText}"
                                                ToolTip="{Binding AutomationHelpText}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRelated}" Value="True">
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderThickness" Value="3" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentStructural}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Category}" FontSize="9"
                                                           Foreground="{StaticResource Brush.AccentStructural}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="9"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                    <TextBlock Text="SELECTED ELEMENT" Style="{StaticResource Text.Eyebrow}" Margin="0,10,0,4" />
                    <StackPanel Margin="0,8,0,0" DataContext="{Binding SelectedTopologyNode}">
                        <TextBlock Text="{Binding AutomationName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AutomationHelpText}" FontSize="10"
                                   Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding InternalRelationships}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Connection}" FontSize="10"
                                               AutomationProperties.Name="{Binding EdgeId}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="RELATIONSHIP INSPECTION" Style="{StaticResource Text.Eyebrow}"
                               Margin="0,10,0,4" />
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="DOMAIN" Style="{StaticResource Text.Eyebrow}" />
                            <ComboBox ItemsSource="{Binding DomainOptions}" SelectedItem="{Binding SelectedDomain, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Filter relationships by domain"
                                      AutomationProperties.HelpText="Shows relationships matching the selected evidence domain." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="SCOPE" Style="{StaticResource Text.Eyebrow}" />
                            <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Filter relationships by scope"
                                      AutomationProperties.HelpText="Shows relationships matching the selected scope." />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearInteractionCommand}"
                                VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="12,5"
                                AutomationProperties.Name="Clear topology selection and filters"
                                AutomationProperties.HelpText="Clears selected elements, selected relationships, and domain and scope filters." />
                    </Grid>
                    <TextBlock Text="{Binding SelectionStatus}" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Topology selection status"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11"
                               Margin="0,0,0,6" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding VisibleRelationships}" SelectedItem="{Binding SelectedRelationship, Mode=TwoWay}"
                             MinHeight="120" MaxHeight="260"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="Directed architecture relationships"
                             AutomationProperties.HelpText="Select a relationship to highlight its source, target, and topology connection.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2" ToolTip="{Binding EvidenceSummary}" AutomationProperties.Name="{Binding Connection}" AutomationProperties.HelpText="{Binding EvidenceSummary}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DomainLabel}" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Connection}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Scope}" FontSize="10"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding EvidenceSummary}" FontSize="9"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="SOURCE EVIDENCE" Style="{StaticResource Text.Eyebrow}" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding EvidenceInspectionStatus}" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="Evidence inspection status"
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="10" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding SelectedEvidenceItems}" SelectedItem="{Binding SelectedEvidenceItem, Mode=TwoWay}"
                             MinHeight="90" MaxHeight="240" Margin="0,5,0,0"
                             AutomationProperties.Name="Selected relationship evidence occurrences"
                             AutomationProperties.HelpText="Select an exact evidence occurrence to inspect its source details.">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" Background="{StaticResource Brush.Panel}"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        AutomationProperties.HelpText="{Binding AutomationHelpText}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Identity}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                                        <TextBlock Text="{Binding Details}" FontSize="10" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SourceLocation}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                                        <Button Content="Open source file" Command="{Binding DataContext.OpenEvidenceSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,5,0,0"
                                                Padding="10,4" IsEnabled="{Binding HasSourceLocation}"
                                                AutomationProperties.Name="{Binding OpenSourceAutomationName}"
                                                AutomationProperties.HelpText="Opens the verified source file within the assessed repository." />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Filters change relationship emphasis and the inspection list; they never remove system elements or alter underlying evidence. Internal relationships remain attached to their owning code container."
                               FontSize="10" Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="6" Margin="-5,0,-5,8">
                <Border Style="{StaticResource Card.Kpi}" MinHeight="66"><StackPanel><TextBlock Text="LOGICAL REGIONS" Style="{StaticResource Text.Eyebrow}" /><TextBlock Text="{Binding LogicalRegionCount}" Style="{StaticResource Text.KpiValue}" FontSize="22" /></StackPanel></Border>
                <Border Style="{StaticResource Card.Kpi}" MinHeight="66"><StackPanel><TextBlock Text="CODE CONTAINERS" Style="{StaticResource Text.Eyebrow}" /><TextBlock Text="{Binding CodeContainerCount}" Style="{StaticResource Text.KpiValue}" FontSize="22" /></StackPanel></Border>
                <Border Style="{StaticResource Card.Kpi}" MinHeight="66"><StackPanel><TextBlock Text="BUILD MODULES" Style="{StaticResource Text.Eyebrow}" /><TextBlock Text="{Binding BuildModuleCount}" Style="{StaticResource Text.KpiValue}" FontSize="22" /></StackPanel></Border>
                <Border Style="{StaticResource Card.Kpi}" MinHeight="66"><StackPanel><TextBlock Text="EXTERNAL RESOURCES" Style="{StaticResource Text.Eyebrow}" /><TextBlock Text="{Binding ExternalResourceCount}" Style="{StaticResource Text.KpiValue}" FontSize="22" /></StackPanel></Border>
                <Border Style="{StaticResource Card.Kpi}" MinHeight="66"><StackPanel><TextBlock Text="DISCOVERED LINKS" Style="{StaticResource Text.Eyebrow}" /><TextBlock Text="{Binding RelationshipCount}" Style="{StaticResource Text.KpiValue}" FontSize="22" /></StackPanel></Border>
                <Border Style="{StaticResource Card.Kpi}" MinHeight="66"><StackPanel><TextBlock Text="UNPROJECTED" Style="{StaticResource Text.Eyebrow}" /><TextBlock Text="{Binding UnprojectedEvidenceCount}" Style="{StaticResource Text.KpiValue}" FontSize="22" /></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="LOGICAL SYSTEM STRUCTURE" Style="{StaticResource Text.Eyebrow}" Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="Nested regions reflect existing architecture classification. Implementation boundaries appear only where membership is unambiguous."
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RootRegions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card.Structural}" Margin="0,0,5,10">
                    <StackPanel>
                        <TextBlock Text="BUILD BOUNDARIES" Style="{StaticResource Text.Eyebrow}" Foreground="{StaticResource Brush.AccentStructural}" />
                        <ItemsControl ItemsSource="{Binding BuildModules}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card.Structural}" Margin="5,0,0,10">
                    <StackPanel>
                        <TextBlock Text="EXTERNAL SYSTEMS &amp; RESOURCES" Style="{StaticResource Text.Eyebrow}" Foreground="{StaticResource Brush.AccentStructural}" />
                        <ItemsControl ItemsSource="{Binding ExternalResources}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="INTERACTION TOPOLOGY" Style="{StaticResource Text.Eyebrow}" Foreground="{StaticResource Brush.AccentStructural}" />
                    <TextBlock Text="Directed connections from the unified evidence graph. Each edge remains distinct; this is not a runtime reachability claim."
                               Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Relationships}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Domain}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentStructural}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Connection}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Scope}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="3" Text="{Binding EvidenceSummary}" FontSize="9" HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card.Structural}" Margin="0,0,5,10">
                    <StackPanel>
                        <TextBlock Text="DECLARED INTEGRATIONS" Style="{StaticResource Text.Eyebrow}" />
                        <ItemsControl ItemsSource="{Binding DeclaredIntegrations}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5,0,0"><TextBlock Text="{Binding SourceModuleName}" FontSize="11" /><TextBlock Text="{Binding TargetModuleName}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" /><TextBlock Text="{Binding Protocol}" FontSize="9" Foreground="{StaticResource Brush.TextMuted}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card.Structural}" Margin="5,0,0,10">
                    <StackPanel>
                        <TextBlock Text="UNCLASSIFIED CODE CONTAINERS" Style="{StaticResource Text.Eyebrow}" />
                        <ItemsControl ItemsSource="{Binding UnclassifiedCodeContainers}">
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5,0,0"><TextBlock Text="{Binding Name}" FontSize="11" /><TextBlock Text="{Binding ClassificationSource}" FontSize="9" Foreground="{StaticResource Brush.TextMuted}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card.Structural}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="UNPROJECTED EVIDENCE &amp; PRESENTATION DIAGNOSTICS" Style="{StaticResource Text.Eyebrow}" />
                    <ItemsControl ItemsSource="{Binding UnprojectedEvidence}">
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4,0,0"><TextBlock Text="{Binding Reason}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding Explanation}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ProjectionDiagnostics}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,4,0,0" Text="{Binding}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
