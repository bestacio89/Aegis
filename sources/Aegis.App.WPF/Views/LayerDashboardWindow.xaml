<Window x:Class="Aegis.App.WPF.Views.LayerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Layer Dashboard" Height="450" Width="800"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Reload" Command="{Binding LoadDataCommand}" Margin="0,0,0,8" Width="100"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Layers}" AutoGenerateColumns="False"
                  Background="#252526" Foreground="White" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="*" />
                <DataGridTextColumn Header="Violations" Binding="{Binding Count}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
