<UserControl x:Class="Aegis.App.Wpf.Views.RuleDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"

             Background="#181818"
             Foreground="White"
             FontFamily="Segoe UI">


    <UserControl.Resources>


        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#222222"/>

            <Setter Property="BorderBrush"
                    Value="#383838"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="14"/>

            <Setter Property="Margin"
                    Value="6"/>

        </Style>



        <Style x:Key="KpiCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#252526"/>

            <Setter Property="BorderBrush"
                    Value="#404040"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Width"
                    Value="180"/>

            <Setter Property="Height"
                    Value="85"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Setter Property="Margin"
                    Value="6"/>

        </Style>


    </UserControl.Resources>





    <Grid Margin="12">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="220"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>







        <!-- HEADER -->


        <Border Style="{StaticResource Card}">


            <StackPanel>


                <TextBlock Text="RULE ENGINE FINDINGS"

                           FontSize="20"

                           FontWeight="SemiBold"

                           Foreground="#FFB300"/>


                <TextBlock Text="Architecture violations detected by Aegis rule evaluation engine"

                           Foreground="#AAAAAA"

                           FontSize="12"

                           Margin="0,4,0,0"/>


            </StackPanel>


        </Border>









        <!-- KPI -->


        <StackPanel Grid.Row="1"

                    Orientation="Horizontal">


            <Border Style="{StaticResource KpiCard}">

                <StackPanel>

                    <TextBlock Text="TOTAL FINDINGS"
                               Foreground="#888888"
                               FontSize="11"/>

                    <TextBlock Text="{Binding TotalViolations}"
                               FontSize="26"
                               FontWeight="Bold"/>

                </StackPanel>

            </Border>




            <Border Style="{StaticResource KpiCard}">

                <StackPanel>

                    <TextBlock Text="CRITICAL"
                               Foreground="#888888"
                               FontSize="11"/>

                    <TextBlock Text="{Binding CriticalCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FF5555"/>

                </StackPanel>

            </Border>





            <Border Style="{StaticResource KpiCard}">

                <StackPanel>

                    <TextBlock Text="BLOCKERS"
                               Foreground="#888888"
                               FontSize="11"/>

                    <TextBlock Text="{Binding BlockerCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FF2222"/>

                </StackPanel>

            </Border>


        </StackPanel>









        <!-- VISUAL ANALYSIS -->


        <Grid Grid.Row="2">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>





            <Border Style="{StaticResource Card}">


                <Grid>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <TextBlock Text="Severity Distribution"

                               Foreground="#BBBBBB"

                               FontWeight="Bold"/>




                    <lvc:PieChart Grid.Row="1"

                                  Margin="0,5"

                                  Series="{Binding SeveritySeries}"

                                  LegendPosition="Right"/>


                </Grid>


            </Border>








            <Border Grid.Column="1"

                    Style="{StaticResource Card}">


                <Grid>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <TextBlock Text="Violations by Category"

                               Foreground="#BBBBBB"

                               FontWeight="Bold"/>




                    <lvc:CartesianChart Grid.Row="1"

                                        Margin="0,5"

                                        Series="{Binding CategorySeries}"

                                        XAxes="{Binding CategoryAxes}"

                                        YAxes="{Binding ValueAxes}"/>


                </Grid>


            </Border>


        </Grid>









        <!-- FINDINGS TABLE -->


        <Border Grid.Row="3"

                Style="{StaticResource Card}">


            <Grid>


                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>




                <TextBlock Text="Architecture Findings"

                           FontWeight="Bold"

                           Foreground="#BBBBBB"

                           Margin="0,0,0,10"/>






                <DataGrid Grid.Row="1"

                          ItemsSource="{Binding RuleResults}"

                          AutoGenerateColumns="False"

                          Background="#181818"

                          Foreground="White"

                          BorderThickness="0"

                          RowBackground="#252526"

                          AlternatingRowBackground="#202020"

                          GridLinesVisibility="None"

                          CanUserAddRows="False"

                          CanUserDeleteRows="False">



                    <DataGrid.Columns>



                        <DataGridTextColumn Header="Rule"
                                            Binding="{Binding RuleName}"
                                            Width="180"/>



                        <DataGridTextColumn Header="Severity"
                                            Binding="{Binding Severity}"
                                            Width="110"/>



                        <DataGridTextColumn Header="Category"
                                            Binding="{Binding Category}"
                                            Width="140"/>



                        <DataGridTextColumn Header="Target"
                                            Binding="{Binding Target}"
                                            Width="220"/>



                        <DataGridTextColumn Header="Finding"
                                            Binding="{Binding Message}"
                                            Width="*"/>


                    </DataGrid.Columns>



                </DataGrid>


            </Grid>


        </Border>


    </Grid>


</UserControl>