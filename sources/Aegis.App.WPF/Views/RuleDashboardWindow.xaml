<Window x:Class="Aegis.App.Wpf.Views.RuleDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Rule Dashboard"
        Width="1200"
        Height="800"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Panel -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- KPI card -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Background="#252526"
                Padding="10"
                CornerRadius="6"
                BorderBrush="#333"
                BorderThickness="1">

            <DockPanel>

                <TextBlock Text="RULE VIOLATION WORKSPACE"
                           Foreground="#00BFFF"
                           FontSize="16"
                           FontWeight="Bold"
                           DockPanel.Dock="Left"/>

                <TextBlock Text="{Binding TotalViolations, StringFormat=Total: {0}}"
                           Foreground="#AAA"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"/>

            </DockPanel>

        </Border>

        <!-- ================= KPI STRIP ================= -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,10">

            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="#888"/>
                    <TextBlock Text="{Binding TotalViolations}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="CRITICAL" Foreground="#888"/>
                    <TextBlock Text="{Binding CriticalCount}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF5555"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="BLOCKERS" Foreground="#888"/>
                    <TextBlock Text="{Binding BlockerCount}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FF2222"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ================= CHART AREA ================= -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PIE: Severity -->
            <Border Style="{StaticResource Panel}">
                <lvc:PieChart Series="{Binding SeveritySeries}"
                              Background="#1E1E1E"
                              LegendPosition="Right"/>
            </Border>

            <!-- BAR: Category -->
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <lvc:CartesianChart Series="{Binding CategorySeries}"
                                    XAxes="{Binding CategoryAxes}"
                                    YAxes="{Binding ValueAxes}"
                                    Background="#1E1E1E"/>
            </Border>

        </Grid>

        <!-- ================= DATA GRID ================= -->
        <Border Grid.Row="3" Style="{StaticResource Panel}">

            <DataGrid ItemsSource="{Binding RuleResults}"
                      AutoGenerateColumns="False"
                      Background="#1E1E1E"
                      Foreground="White"
                      BorderBrush="#333"
                      RowBackground="#2A2A2A"
                      AlternatingRowBackground="#242424"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding RuleId}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding RuleName}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Severity"
                                        Binding="{Binding Severity}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Target"
                                        Binding="{Binding Target}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Message"
                                        Binding="{Binding Message}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>
</Window>