<UserControl x:Class="Aegis.App.Wpf.Views.SectionDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"

             Background="#181818"
             Foreground="White"
             FontFamily="Segoe UI">


    <UserControl.Resources>


        <Style x:Key="Card"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#222222"/>

            <Setter Property="BorderBrush"
                    Value="#383838"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="14"/>

            <Setter Property="Margin"
                    Value="6"/>

        </Style>




        <Style x:Key="KpiCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#252526"/>

            <Setter Property="Width"
                    Value="180"/>

            <Setter Property="Height"
                    Value="85"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Setter Property="Margin"
                    Value="6"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="BorderBrush"
                    Value="#404040"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


    </UserControl.Resources>





    <Grid Margin="12">


        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="230"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>







        <!-- HEADER -->


        <Border Style="{StaticResource Card}">


            <StackPanel>


                <TextBlock Text="ARCHITECTURE OVERVIEW"

                           FontSize="20"

                           FontWeight="SemiBold"

                           Foreground="#00BFFF"/>


                <TextBlock Text="Structural compliance assessment across analyzed architecture sections"

                           Foreground="#AAAAAA"

                           FontSize="12"

                           Margin="0,4,0,0"/>


            </StackPanel>


        </Border>









        <!-- KPIS -->


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">


            <Border Style="{StaticResource KpiCard}">

                <StackPanel>

                    <TextBlock Text="SECTIONS"

                               Foreground="#888888"

                               FontSize="11"/>


                    <TextBlock Text="{Binding TotalSections}"

                               FontSize="26"

                               FontWeight="Bold"/>

                </StackPanel>

            </Border>





            <Border Style="{StaticResource KpiCard}">

                <StackPanel>

                    <TextBlock Text="COMPLIANT"

                               Foreground="#888888"

                               FontSize="11"/>


                    <TextBlock Text="{Binding CompliantCount}"

                               FontSize="26"

                               FontWeight="Bold"

                               Foreground="#4CAF50"/>

                </StackPanel>

            </Border>





            <Border Style="{StaticResource KpiCard}">

                <StackPanel>

                    <TextBlock Text="AT RISK"

                               Foreground="#888888"

                               FontSize="11"/>


                    <TextBlock Text="{Binding NonCompliantCount}"

                               FontSize="26"

                               FontWeight="Bold"

                               Foreground="#FF5555"/>

                </StackPanel>

            </Border>


        </StackPanel>









        <!-- VISUAL SUMMARY -->


        <Grid Grid.Row="2">


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>





            <Border Style="{StaticResource Card}">


                <Grid>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>



                    <TextBlock Text="Compliance Status"

                               FontWeight="Bold"

                               Foreground="#BBBBBB"/>




                    <lvc:PieChart Grid.Row="1"

                                  Margin="0,5"

                                  Series="{Binding CompliancePieSeries}"

                                  LegendPosition="Right"/>


                </Grid>


            </Border>









            <Border Grid.Column="1"

                    Style="{StaticResource Card}">


                <Grid>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>




                    <TextBlock Text="Section Risk Distribution"

                               FontWeight="Bold"

                               Foreground="#BBBBBB"/>




                    <lvc:CartesianChart Grid.Row="1"

                                        Margin="0,5"

                                        Series="{Binding SectionCategorySeries}"

                                        XAxes="{Binding CategoryAxes}"

                                        YAxes="{Binding ValueAxes}"/>


                </Grid>


            </Border>


        </Grid>









        <!-- SECTION FINDINGS -->


        <Border Grid.Row="3"

                Style="{StaticResource Card}">


            <Grid>


                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>




                <TextBlock Text="Architecture Sections"

                           Foreground="#BBBBBB"

                           FontWeight="Bold"

                           Margin="0,0,0,10"/>






                <DataGrid Grid.Row="1"

                          ItemsSource="{Binding SectionResults}"

                          AutoGenerateColumns="False"

                          Background="#181818"

                          Foreground="White"

                          BorderThickness="0"

                          RowBackground="#252526"

                          AlternatingRowBackground="#202020"

                          GridLinesVisibility="None"

                          CanUserAddRows="False"

                          CanUserDeleteRows="False">



                    <DataGrid.Columns>


                        <DataGridTextColumn Header="Section"

                                            Binding="{Binding SectionName}"

                                            Width="180"/>



                        <DataGridTextColumn Header="Status"

                                            Binding="{Binding ComplianceStatus}"

                                            Width="120"/>



                        <DataGridTextColumn Header="Category"

                                            Binding="{Binding Category}"

                                            Width="140"/>



                        <DataGridTextColumn Header="Score"

                                            Binding="{Binding Score}"

                                            Width="80"/>



                        <DataGridTextColumn Header="Remarks"

                                            Binding="{Binding Remarks}"

                                            Width="*"/>


                    </DataGrid.Columns>


                </DataGrid>


            </Grid>


        </Border>


    </Grid>


</UserControl>