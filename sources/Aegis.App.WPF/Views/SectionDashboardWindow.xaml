<Window x:Class="Aegis.App.Wpf.Views.SectionDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="📊 Section Dashboard"
        Height="700" Width="1000"
        Background="#1e1e1e"
        Foreground="White"
        FontFamily="Consolas"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="📊 Section Compliance Dashboard"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#00BFFF"
                   Margin="0,0,0,10"/>

        <!-- KPIs -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">

            <Border Background="#2b2b2b" Padding="12" CornerRadius="8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Sections" Foreground="#AAA"/>
                    <TextBlock Text="{Binding TotalSections}"
                               FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#2b2b2b" Padding="12" CornerRadius="8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Compliant" Foreground="#AAA"/>
                    <TextBlock Text="{Binding CompliantCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#55FF55"/>
                </StackPanel>
            </Border>

            <Border Background="#2b2b2b" Padding="12" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Non-Compliant" Foreground="#AAA"/>
                    <TextBlock Text="{Binding NonCompliantCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FF5555"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- CHARTS -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PIE (Compliance ratio) -->
            <lvc:PieChart Grid.Column="0"
                          Series="{Binding CompliancePieSeries}"
                          Background="#1e1e1e"
                          LegendPosition="Right"
                          Margin="8"/>

            <!-- BAR (Section distribution) -->
            <lvc:CartesianChart Grid.Column="1"
                                Series="{Binding SectionCategorySeries}"
                                XAxes="{Binding CategoryAxes}"
                                YAxes="{Binding ValueAxes}"
                                Background="#1e1e1e"
                                Margin="8"/>
        </Grid>

        <!-- DATA GRID -->
        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding SectionResults}"
                  HeadersVisibility="Column"
                  RowBackground="#2a2a2a"
                  AlternatingRowBackground="#242424"
                  BorderBrush="#444"
                  BorderThickness="1"
                  Foreground="White"
                  Background="#202020"
                  Margin="0,16,0,0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Section ID" Binding="{Binding SectionId}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding SectionName}" Width="180"/>
                <DataGridTextColumn Header="Compliance" Binding="{Binding ComplianceStatus}" Width="120"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="100"/>
                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>