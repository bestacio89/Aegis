<UserControl x:Class="Aegis.Wpf.Views.Security.SecurityFindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Aegis.Wpf.Converters"
             Background="{StaticResource Brush.Ink}"
             Foreground="{StaticResource Brush.TextPrimary}"
             FontFamily="{StaticResource Font.Body}">

    <UserControl.Resources>
        <conv:SecuritySeverityToBrushConverter x:Key="SeverityBrush"/>

        <!-- Detail card hides itself while nothing is selected. -->
        <Style x:Key="DetailCard" TargetType="Border" BasedOn="{StaticResource Card.Structural}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.TopRule}"/>
            <Border Grid.Row="1" Style="{StaticResource Card.Structural}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="FINDINGS EXPLORER" Style="{StaticResource Text.Eyebrow}"
                                   Foreground="{StaticResource Brush.AccentStructural}"/>
                        <TextBlock Text="Filter by domain, minimum severity or free text. Select a row for details and remediation."
                                   Foreground="{StaticResource Brush.TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CountLabel}"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center" FontFamily="{StaticResource Font.Data}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- FILTERS -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource Brush.Panel}"
                     Foreground="{StaticResource Brush.TextPrimary}"
                     CaretBrush="{StaticResource Brush.TextPrimary}"
                     BorderBrush="{StaticResource Brush.Line}"
                     Padding="8,6"
                     ToolTip="Search rule id, title, target, location or detail"/>

            <ComboBox Grid.Column="1" Width="190" Margin="8,0,0,0"
                      ItemsSource="{Binding DomainOptions}"
                      SelectedItem="{Binding SelectedDomainOption, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      ToolTip="Domain"/>

            <ComboBox Grid.Column="2" Width="120" Margin="8,0,0,0"
                      ItemsSource="{Binding SeverityOptions}"
                      SelectedItem="{Binding MinimumSeverity, Mode=TwoWay}"
                      ToolTip="Minimum severity"/>
        </Grid>

        <!-- LEDGER -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.TopRule}"/>
            <Border Grid.Row="1" Style="{StaticResource Card.Structural}">
                <DataGrid ItemsSource="{Binding FilteredFindings}"
                          SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          Style="{StaticResource Grid.Ledger}"
                          ColumnHeaderStyle="{StaticResource Grid.LedgerHeader}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Severity" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            CornerRadius="3" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Severity}"
                                                   Foreground="{StaticResource Brush.Ink}"
                                                   FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="130"/>
                        <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="150"/>
                        <DataGridTextColumn Header="Finding" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="240"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- DETAIL -->
        <Border Grid.Row="3" Style="{StaticResource DetailCard}" Margin="0,10,0,0" MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedFinding}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,2,0,8"
                               FontFamily="{StaticResource Font.Data}">
                        <Run Text="{Binding RuleId, Mode=OneWay}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding Domain, Mode=OneWay}"/>
                        <Run Text=" | "/>
                        <Run Text="{Binding Severity, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Remediation, StringFormat='Remediation: {0}', TargetNullValue=''}"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.StatusCompliant}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Location, StringFormat='Location: {0}', TargetNullValue=''}"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"/>
                    <TextBlock Text="{Binding Reference, StringFormat='Reference: {0}', TargetNullValue=''}"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}" FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
