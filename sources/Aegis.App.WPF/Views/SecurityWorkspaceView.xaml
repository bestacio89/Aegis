<UserControl x:Class="Aegis.Wpf.Views.Security.SecurityWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Brush.Ink}"
             Foreground="{StaticResource Brush.TextPrimary}"
             FontFamily="{StaticResource Font.Body}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentStructural}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card.TopRule}"/>
            <Border Grid.Row="1" Style="{StaticResource Card.Structural}">
                <StackPanel>
                    <TextBlock Text="SECURITY ASSESSMENT" Style="{StaticResource Text.Eyebrow}"
                               Foreground="{StaticResource Brush.AccentStructural}"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ToolbarTextBox}"
                                 ToolTip="Folder of the project to assess"/>

                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding BrowseCommand}"/>

                        <TextBox Grid.Column="2" Width="110" Margin="8,0,0,0"
                                 Text="{Binding ScanEnvironment, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ToolbarTextBox}"
                                 ToolTip="Environment label recorded in the report"/>

                        <Button Grid.Column="3" Content="Run scan" Margin="8,0,0,0"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding RunScanCommand}"/>

                        <Button Grid.Column="4" Content="Cancel" Margin="8,0,0,0"
                                Style="{StaticResource Button.Primary}"
                                Background="{StaticResource Brush.StatusWarning}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                        <ComboBox Grid.Column="5" Width="80" Margin="8,0,0,0"
                                  ItemsSource="{Binding ExportFormats}"
                                  SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}"
                                  ToolTip="Export format"/>

                        <Button Grid.Column="6" Content="Export" Margin="8,0,0,0"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ExportReportCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- STATUS -->
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                         Foreground="{StaticResource Brush.AccentStructural}"
                         Background="{StaticResource Brush.Line}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="12" Margin="2,6,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.StatusCritical}"
                       FontSize="12" Margin="2,2,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- TABS -->
        <ListBox Grid.Row="2" Margin="0,8,0,0"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource TabItemStyle}"
                 Background="Transparent" BorderThickness="0"
                 Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- CONTENT / EMPTY STATE -->
        <Grid Grid.Row="3">
            <ContentControl Content="{Binding ActiveContent}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"/>

            <Border Style="{StaticResource Card.Structural}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,24"
                    Visibility="{Binding NoResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="No security scan yet" Style="{StaticResource Text.SectionTitle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Pick a project folder and press Run scan."
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
