{
  "Naming": {
    "Enabled": true,
    "EnforcePascalCase": true,
    "RequireInterfacePrefix": true,
    "EnforceSuffixForModels": true,
    "AllowedModelSuffixes": [
      "Dto",
      "ViewModel",
      "Model"
    ],
    "EnforceComponentSuffix": true,
    "AllowedComponentSuffixes": [
      "Controller",
      "Service",
      "Repository",
      "Manager",
      "Handler",
      "Adapter"
    ],
    "EnforceCamelCaseForMethods": false,
    "AllowedMethodPrefixes": [
      "Get",
      "Set",
      "Load",
      "Create",
      "Update",
      "Delete",
      "Add",
      "Remove",
      "Find",
      "Calculate",
      "Handle",
      "Resolve"
    ],
    "StaticMethodsPascalCase": true,
    "AllowSnakeCase": false,
    "AllowAllCapsConstants": true,
    "EnforceCamelCaseForVariables": true,
    "EnforcePascalCaseForProperties": true,
    "EnforceFileNameMatch": true,
    "EnforcePluralization": false,
    "EnforceNamespaceStructure": true,
    "AllowLowercaseNamespaces": false,
    "MinOverallCompliance": 95,
    "MinCategoryCompliance": 95,
    "DetectAcronymViolations": true,
    "EnforceAcronymNormalization": true,
    "DisallowTestOrTempPrefixes": false,
    "ForbiddenPrefixes": [
      "Tmp",
      "Temp",
      "Foo",
      "Bar",
      "Test",
      "Dummy",
      "Sample",
      "Old",
      "Legacy"
    ],
    "DetectRedundantSuffixes": true
  }
}