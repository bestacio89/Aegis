<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Aegis.Architecture</AssemblyName>
    <RootNamespace>Aegis.Architecture</RootNamespace>
    <Description>
      Core rule engine and evaluation logic for Aegis.
      Handles scanning orchestration, rule evaluation, and scoring.
    </Description>

    <FrontendAnalyzerDirectory>
      $(MSBuildProjectDirectory)\Evaluators\FrontEnd
    </FrontendAnalyzerDirectory>

    <FrontendAnalyzerEntryPoint>
      $(FrontendAnalyzerDirectory)\frontend-analyzer.mjs
    </FrontendAnalyzerEntryPoint>

    <FrontendAnalyzerOutputDirectory>
      $(OutDir)Evaluators\FrontEnd
    </FrontendAnalyzerOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegis.Shared\Aegis.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Franz.Common.Mediator" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Logging" Version="2.2.17" />
    <PackageReference Include="Franz.Common.DependencyInjection" Version="2.2.17" />

    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />

    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />

    <PackageReference Include="Jint" Version="4.2.1" />
    <PackageReference Include="AngleSharp" Version="1.3.0" />
  </ItemGroup>

  <!-- Validate and restore the Node.js analyzer dependencies before building. -->
  <Target
    Name="PrepareFrontendAnalyzer"
    BeforeTargets="Build"
    Condition="Exists('$(FrontendAnalyzerDirectory)\package.json') and '$(DesignTimeBuild)' != 'true'">

    <Error
      Condition="!Exists('$(FrontendAnalyzerEntryPoint)')"
      Text="Frontend analyzer entry point is missing: $(FrontendAnalyzerEntryPoint)" />

    <Error
      Condition="!Exists('$(FrontendAnalyzerDirectory)\package-lock.json')"
      Text="Frontend analyzer package-lock.json is missing. Run npm install in Evaluators\FrontEnd." />

    <Exec
      Command="npm ci --no-audit --no-fund"
      WorkingDirectory="$(FrontendAnalyzerDirectory)" />

    <Error
      Condition="!Exists('$(FrontendAnalyzerDirectory)\node_modules\typescript\package.json')"
      Text="Frontend analyzer dependency 'typescript' is missing after npm ci." />

    <Error
      Condition="!Exists('$(FrontendAnalyzerDirectory)\node_modules\@angular\compiler\package.json')"
      Text="Frontend analyzer dependency '@angular/compiler' is missing after npm ci." />
  </Target>

  <!-- Copy the analyzer as a runtime asset, never as a C# Compile item. -->
  <Target
    Name="CopyFrontendAnalyzerToOutput"
    AfterTargets="Build"
    Condition="Exists('$(FrontendAnalyzerDirectory)\package.json')">

    <ItemGroup>
      <FrontendAnalyzerRuntimeFiles Include="$(FrontendAnalyzerEntryPoint)" />
      <FrontendAnalyzerRuntimeFiles Include="$(FrontendAnalyzerDirectory)\package.json" />
      <FrontendAnalyzerRuntimeFiles Include="$(FrontendAnalyzerDirectory)\package-lock.json" />
      <FrontendAnalyzerRuntimeFiles Include="$(FrontendAnalyzerDirectory)\node_modules\**\*" />
    </ItemGroup>

    <MakeDir Directories="$(FrontendAnalyzerOutputDirectory)" />

    <Copy
      SourceFiles="@(FrontendAnalyzerRuntimeFiles)"
      DestinationFiles="@(FrontendAnalyzerRuntimeFiles->'$(FrontendAnalyzerOutputDirectory)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
