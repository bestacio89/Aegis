<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared build configuration -->



  <!-- =============================================
       AEGIS CORE — Rule Engine and Evaluation Logic
       ============================================= -->
  <PropertyGroup>
    <AssemblyName>Aegis.Core</AssemblyName>
    <RootNamespace>Aegis.Core</RootNamespace>
    <Description>
      Core rule engine and evaluation logic for Aegis.
      Handles scanning orchestration, rule evaluation, and scoring.
    </Description>
  </PropertyGroup>

  <!-- =============================================
       Folder Structure (for clarity in Solution Explorer)
       ============================================= -->

  <!-- =============================================
       Project References
       ============================================= -->
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Shared\Aegis.Shared.csproj" />
  </ItemGroup>

  <!-- =============================================
       Dependencies (explicit)
       ============================================= -->
  <ItemGroup>
    <!-- Franz Framework Core -->
    <PackageReference Include="Franz.Common.Mediator" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Logging" Version="2.2.17" />
    <PackageReference Include="Franz.Common.DependencyInjection" Version="2.2.17" />

    <!-- Utilities -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Optional: future extensibility -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
