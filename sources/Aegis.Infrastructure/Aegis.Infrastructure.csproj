<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared build configuration -->

  

  <!-- =============================================
       AEGIS INFRASTRUCTURE — Persistence & Reporting Layer
       ============================================= -->
  <PropertyGroup>
    <AssemblyName>Aegis.Infrastructure</AssemblyName>
    <RootNamespace>Aegis.Infrastructure</RootNamespace>
    <Description>
      Infrastructure components for Aegis.
      Handles persistence, reporting, and external integrations.
    </Description>
  </PropertyGroup>

  <!-- =============================================
       Folder Structure (for clarity in Solution Explorer)
       ============================================= -->
  <ItemGroup>
    <Folder Include="Integration\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Franz.Common" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Business" Version="2.2.17" />
    <PackageReference Include="Franz.Common.DependencyInjection" Version="2.2.17" />
    <PackageReference Include="Franz.Common.EntityFramework" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Errors" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Http.EntityFramework" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Mediator" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Reflection" Version="2.2.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>

  <!-- =============================================
       Project References
       ============================================= -->
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Core\Aegis.Architecture.csproj" />
    <ProjectReference Include="..\Aegis.Shared\Aegis.Shared.csproj" />
  </ItemGroup>

  <!-- =============================================
       Dependencies (explicit, fine-grained)
       ============================================= -->
  
  
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="RazorLight" Version="2.3.1" />
    <PackageReference Include="Franz.Common.Logging" Version="2.2.17" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
