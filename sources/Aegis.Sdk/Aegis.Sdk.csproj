<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared build configuration -->



  <!-- =============================================
       AEGIS SDK — Extensibility & Plugin Contracts
       ============================================= -->
  <PropertyGroup>
    <AssemblyName>Aegis.SDK</AssemblyName>
    <RootNamespace>Aegis.SDK</RootNamespace>
    <Description>
      Extensibility SDK for Aegis.
      Defines contracts for rules, analyzers, and plugin modules.
    </Description>
 

    <!-- NuGet Metadata -->
    <PackageId>Aegis.SDK</PackageId>
    <Authors>Bernardo Estacio Abreu</Authors>
    <Company>AjnaTellus Systems</Company>
    <Product>Aegis</Product>
    <RepositoryUrl>https://dev.azure.com/Ajna/Aegis</RepositoryUrl>
    <Copyright>© 2025 AjnaTellus Systems</Copyright>

    <!-- SDK assemblies are usually library-only -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- =============================================
       Folder Structure
       ============================================= -->

  <!-- =============================================
       Project References
       ============================================= -->
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Core\Aegis.Architecture.csproj" />
    <ProjectReference Include="..\Aegis.Infrastructure\Aegis.Infrastructure.csproj" />
    <ProjectReference Include="..\Aegis.Security\Aegis.Security.csproj" />
    <ProjectReference Include="..\Aegis.Shared\Aegis.Shared.csproj" />
  </ItemGroup>

  <!-- =============================================
       Dependencies (explicit, minimal)
       ============================================= -->
  <ItemGroup>
    <!-- Franz DI enables plugin/service registration -->
    <PackageReference Include="Franz.Common.Business" Version="2.2.17" />
    <PackageReference Include="Franz.Common.DependencyInjection" Version="2.2.17" />
    <PackageReference Include="Franz.Common.Logging" Version="2.2.17" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.9" />
  </ItemGroup>

</Project>
