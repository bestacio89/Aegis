plugins {
    java
    alias(libs.plugins.spring.boot)
}

dependencies {
    implementation(project(":api"))
    implementation(libs.spring.context)
    annotationProcessor(libs.mapstruct.processor)
    testImplementation(libs.junit.api)
    runtimeOnly("org.example.external:missing-at-runtime:9.9.9")
    contractTestImplementation("org.example:contract-test-kit:1.0")
}

sourceSets {
    main {
        java.srcDir(layout.buildDirectory.dir("generated/sources/annotations"))
    }
    create("contractTest") {
        java.srcDir("src/contractTest/java")
        compileClasspath += sourceSets.main.get().output
        runtimeClasspath += output + compileClasspath
    }
}
