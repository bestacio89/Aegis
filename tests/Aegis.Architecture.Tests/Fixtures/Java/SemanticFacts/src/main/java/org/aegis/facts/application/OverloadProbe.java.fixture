package org.aegis.facts.application;

public final class OverloadProbe {
    private OverloadProbe() {
    }

    public static String select(String value) {
        return value;
    }

    public static String select(Integer value) {
        return value.toString();
    }

    public static <T> T select(T value, Class<T> type) {
        return type.cast(value);
    }
}
