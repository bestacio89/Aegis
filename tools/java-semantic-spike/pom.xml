<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.aegis.tools</groupId>
  <artifactId>java-semantic-spike</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Aegis Java Semantic Engine Spike</name>
  <description>Isolated, non-production comparison of Eclipse JDT and JavaParser symbol resolution.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jdt.version>3.47.0</jdt.version>
    <javaparser.version>3.28.2</javaparser.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.8.0-jre</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>org.eclipse.jdt.core</artifactId>
      <version>${jdt.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-symbol-solver-core</artifactId>
      <version>${javaparser.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>org.aegis.spike.SemanticEngineBenchmark</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>module-visibility</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.aegis.spike.ModuleVisibilityBenchmark</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>semantic-fact-validation</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.aegis.spike.SemanticFactCorpusValidator</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>semantic-fact-benchmark</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.aegis.spike.SemanticFactBenchmark</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>semantic-diagnostic-validation</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.aegis.spike.SemanticDiagnosticCorpusValidator</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>semantic-diagnostic-benchmark</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.aegis.spike.SemanticDiagnosticBenchmark</mainClass>
            </configuration>
          </execution>
          <execution>
            <id>semantic-performance-benchmark</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>org.aegis.spike.SemanticPerformanceBenchmark</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
